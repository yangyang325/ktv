{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "noImplicitAny": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "miniprogram/*"
      ]
    },
    "types": [
      "miniprogram-api-typings"
    ]
  },
  "include": [
    "miniprogram/**/*.ts"
  ],
  "exclude": [
    "miniprogram/tests/**/*.ts"
  ]
}

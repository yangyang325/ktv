<view class="page profile-page">
  <view class="profile-shell">
    <view class="profile-banner">
      <image class="profile-banner__bg" src="https://wechatapppro-1252524126.cdn.xiaoeknow.com/appbtajnbm33436/image/b_u_616d1cc7eabb6_eanzXeE6/thucmfmpw0ley0.png" mode="aspectFill" />
      <view class="profile-banner__halo profile-banner__halo--left"></view>
      <view class="profile-banner__halo profile-banner__halo--right"></view>
      <view class="profile-banner__wave profile-banner__wave--one"></view>
      <view class="profile-banner__wave profile-banner__wave--two"></view>

      <view class="profile-banner__content">
        <view class="profile-banner__row">
          <image class="profile-banner__avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
          <view class="profile-banner__info">
            <view class="profile-banner__name-row">
              <text class="profile-banner__name">{{profile.nickname}}</text>
              <image class="profile-banner__verify" src="{{profile.genderIconUrl}}" mode="aspectFit" />
            </view>
            <text class="profile-banner__intro">{{profile.intro}}</text>
          </view>
          <button class="profile-banner__edit" bindtap="handleEditProfile">
            <text>编辑资料</text>
          </button>
        </view>
      </view>
    </view>

    <view class="profile-content">
      <view class="stats-card">
        <view
          class="stats__item {{item.target ? 'stats__item--tap' : ''}}"
          wx:for="{{profile.stats}}"
          wx:key="label"
          data-target="{{item.target}}"
          bindtap="handleStatTap"
        >
          <text class="stats__value">{{item.value}}</text>
          <text class="stats__label">{{item.label}}</text>
        </view>
      </view>

      <view class="profile-section-card profile-tags-card">
        <view class="profile-section-card__header">
          <view class="profile-section-card__title">
            <image class="profile-section-card__icon" src="/assets/images/ktv/profile-section-tags.svg" mode="aspectFit" />
            <text>我的标签</text>
          </view>
          <button class="profile-section-card__link" bindtap="handleEditTags">
            <text>编辑标签</text>
            <text class="profile-section-card__arrow">›</text>
          </button>
        </view>
        <view class="profile-tags-grid" wx:if="{{profile.userTags.length}}">
          <text
            class="profile-tag profile-tag--{{item.tone}}"
            wx:for="{{profile.userTags}}"
            wx:key="label"
          >{{item.label}}</text>
        </view>
        <view class="profile-tags-empty" wx:else>
          <text>选择适合你的K歌标签</text>
        </view>
      </view>

      <view class="profile-section-card profile-achievement-card">
        <view class="profile-section-card__header">
          <view class="profile-section-card__title">
            <image class="profile-section-card__icon" src="/assets/images/ktv/profile-section-achievement.svg" mode="aspectFit" />
            <text>我的成就</text>
          </view>
          <button class="profile-section-card__link" bindtap="handleViewAchievements">
            <text>全部成就</text>
            <text class="profile-section-card__arrow">›</text>
          </button>
        </view>
        <view class="profile-achievement-list">
          <view
            class="profile-achievement profile-achievement--{{item.tone}} {{item.unlocked ? '' : 'profile-achievement--locked'}}"
            wx:for="{{profile.achievements}}"
            wx:key="key"
          >
            <view class="profile-achievement__badge">
              <image class="profile-achievement__icon" src="{{item.iconUrl}}" mode="aspectFit" />
            </view>
            <text class="profile-achievement__title">{{item.title}}</text>
            <text class="profile-achievement__desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <view class="menu-card">
        <view
          class="menu-card__item"
          wx:for="{{menu}}"
          wx:key="key"
          data-key="{{item.key}}"
          data-label="{{item.label}}"
          data-contact="{{item.contact}}"
          bindtap="handleMenuTap"
        >
          <view class="menu-card__label">
            <image class="menu-card__icon" src="{{item.iconUrl}}" mode="aspectFit" />
            <view class="menu-card__text">
              <text class="menu-card__title">{{item.label}}</text>
              <text class="menu-card__desc">{{item.desc}}</text>
            </view>
          </view>
          <text class="menu-card__action">{{item.actionText}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

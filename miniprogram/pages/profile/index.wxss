.profile-page {
  padding-bottom: 40rpx;
}

.profile-hero {
  padding: 48rpx 28rpx 86rpx;
  border-bottom-left-radius: 42rpx;
  border-bottom-right-radius: 42rpx;
  background: linear-gradient(135deg, #526fff 0%, #744eff 58%, #8a75ff 100%);
  color: #ffffff;
}

.profile-hero__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.profile-hero__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.46);
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd5b9, #8f62ff);
  font-size: 42rpx;
  font-weight: 900;
}

.profile-hero__info {
  min-width: 0;
  flex: 1;
}

.profile-hero__name {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
}

.profile-hero__intro {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 23rpx;
}

.profile-hero__edit {
  height: 54rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 54rpx;
}

.profile-hero__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-left: 124rpx;
}

.profile-hero__tags text {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}

.stats-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: -50rpx 28rpx 0;
  padding: 26rpx 0;
  border-radius: 24rpx;
  background: var(--surface-bg);
  box-shadow: var(--shadow-soft);
}

.stats__item {
  text-align: center;
}

.stats__value {
  display: block;
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 900;
}

.stats__label {
  display: block;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
}

.shortcut-card,
.menu-card {
  margin: 24rpx 28rpx 0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: var(--shadow-card);
}

.shortcut-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 28rpx 10rpx;
}

.shortcut-card__item {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.shortcut-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ff8aaa, #ff4c70);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.shortcut-card__icon--notes {
  background: linear-gradient(135deg, #5fc9ff, #5177ff);
}

.shortcut-card__icon--groups {
  background: linear-gradient(135deg, #55df93, #23c272);
}

.shortcut-card__icon--reviews {
  background: linear-gradient(135deg, #ffb75d, #ff8752);
}

.shortcut-card__label {
  margin-top: 12rpx;
  color: var(--text-primary);
  font-size: 22rpx;
}

.menu-card {
  overflow: hidden;
}

.menu-card__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  color: var(--text-primary);
  font-size: 27rpx;
}

.menu-card__item + .menu-card__item {
  border-top: 1rpx solid var(--border-color);
}

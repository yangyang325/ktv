.profile-page {
  min-height: 100vh;
  overflow: hidden;
  padding-bottom: 196rpx;
  background:
    radial-gradient(circle at 12% 18%, rgba(117, 118, 255, 0.12) 0, rgba(117, 118, 255, 0) 28%),
    linear-gradient(180deg, #fbfcff 0%, #f5f6ff 64%, #ffffff 100%);
  box-sizing: border-box;
}

.profile-shell {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

.profile-banner {
  position: relative;
  min-height: 556rpx;
  margin-top: 0;
  overflow: hidden;
  padding: 204rpx 30rpx 104rpx;
  border-bottom-right-radius: 34rpx;
  border-bottom-left-radius: 34rpx;
  background:
    radial-gradient(circle at 22% 4%, rgba(181, 210, 255, 0.4) 0, rgba(181, 210, 255, 0) 26%),
    radial-gradient(circle at 86% 16%, rgba(255, 159, 230, 0.22) 0, rgba(255, 159, 230, 0) 27%),
    linear-gradient(135deg, #6866ff 0%, #7258ff 48%, #8d54ff 100%);
  box-shadow:
    0 22rpx 56rpx rgba(93, 78, 220, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.28);
  box-sizing: border-box;
  color: #ffffff;
}

.profile-banner__bg {
  position: absolute;
  z-index: 0;
  inset: 0;
  width: 100%;
  height: 100%;
}

.profile-banner::after {
  position: absolute;
  z-index: 1;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(10, 12, 24, 0.18) 0%, rgba(10, 12, 24, 0.04) 46%, rgba(92, 72, 255, 0.24) 100%),
    linear-gradient(90deg, rgba(54, 50, 130, 0.16), rgba(255, 255, 255, 0));
  content: "";
}

.profile-banner__content {
  position: relative;
  z-index: 3;
}

.profile-banner__halo,
.profile-banner__wave {
  position: absolute;
  z-index: 2;
  pointer-events: none;
}

.profile-banner__halo {
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.profile-banner__halo--left {
  bottom: -44rpx;
  left: 74rpx;
  width: 252rpx;
  height: 188rpx;
  transform: rotate(-18deg);
}

.profile-banner__halo--right {
  right: -30rpx;
  bottom: -32rpx;
  width: 290rpx;
  height: 168rpx;
  transform: rotate(-8deg);
}

.profile-banner__wave {
  right: 12rpx;
  bottom: 32rpx;
  left: 214rpx;
  height: 82rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.1);
  border-bottom: 0;
  border-radius: 50% 50% 0 0;
  transform: rotate(-2deg);
}

.profile-banner__wave--two {
  right: 128rpx;
  bottom: 16rpx;
  left: 114rpx;
  opacity: 0.58;
  transform: rotate(3deg);
}

.profile-banner__row {
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.profile-banner__avatar {
  width: 132rpx;
  height: 132rpx;
  flex: 0 0 132rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 18rpx 34rpx rgba(28, 33, 112, 0.24);
  box-sizing: border-box;
}

.profile-banner__info {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
  padding-top: 16rpx;
}

.profile-banner__name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.profile-banner__name {
  max-width: 208rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.08;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-banner__verify {
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  margin-left: 14rpx;
}

.profile-banner__intro {
  display: block;
  overflow: hidden;
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-banner__edit {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 58rpx;
  flex: 0 0 144rpx;
  margin: 20rpx 0 0 12rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.profile-content {
  position: relative;
  z-index: 2;
  min-height: 560rpx;
  margin-top: -74rpx;
  padding: 0 0 196rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: #f6f8ff;
  box-sizing: border-box;
}

.stats-card {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  min-height: 162rpx;
  margin: 0 28rpx;
  padding: 34rpx 0 28rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 20rpx 46rpx rgba(36, 39, 78, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  box-sizing: border-box;
  transform: translateY(-52rpx);
}

.stats__item {
  text-align: center;
}

.stats__value {
  display: block;
  color: #202238;
  font-size: 43rpx;
  font-weight: 900;
  line-height: 1.03;
}

.stats__label {
  display: block;
  margin-top: 12rpx;
  color: #686f87;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.12;
}

.menu-card {
  margin-right: 28rpx;
  margin-left: 28rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 38rpx rgba(42, 48, 100, 0.07);
}

.menu-card {
  overflow: hidden;
  margin-top: 22rpx;
  padding: 0 34rpx;
}

.menu-card__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 120rpx;
  color: #282c45;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.menu-card__item + .menu-card__item {
  border-top: 1rpx solid #edf0f8;
}

.menu-card__label {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.menu-card__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 28rpx;
  flex: 0 0 40rpx;
}

.menu-card__text {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.menu-card__title {
  overflow: hidden;
  color: #282c45;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-card__desc {
  overflow: hidden;
  margin-top: 10rpx;
  color: #747b91;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-card__action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 78rpx;
  height: 48rpx;
  flex: 0 0 auto;
  margin-left: 24rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f1efff;
  color: #6048ff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.profile-page {
  min-height: 100vh;
  overflow: hidden;
  padding-bottom: 196rpx;
  background:
    radial-gradient(circle at 12% 18%, rgba(117, 118, 255, 0.12) 0, rgba(117, 118, 255, 0) 28%),
    linear-gradient(180deg, #fbfcff 0%, #f5f6ff 64%, #ffffff 100%);
  box-sizing: border-box;
}

.profile-nav {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  left: 0;
  background: rgba(251, 252, 255, 0.92);
  box-sizing: border-box;
}

.profile-nav__bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.profile-nav__title {
  color: #141627;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.profile-shell {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

.profile-banner {
  position: relative;
  min-height: 420rpx;
  margin-top: 0;
  overflow: hidden;
  padding: 68rpx 30rpx 104rpx;
  border-bottom-right-radius: 34rpx;
  border-bottom-left-radius: 34rpx;
  background:
    radial-gradient(circle at 22% 4%, rgba(181, 210, 255, 0.4) 0, rgba(181, 210, 255, 0) 26%),
    radial-gradient(circle at 86% 16%, rgba(255, 159, 230, 0.22) 0, rgba(255, 159, 230, 0) 27%),
    linear-gradient(135deg, #6866ff 0%, #7258ff 48%, #8d54ff 100%);
  box-shadow:
    0 22rpx 56rpx rgba(93, 78, 220, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.28);
  box-sizing: border-box;
  color: #ffffff;
}

.profile-banner__content {
  position: relative;
  z-index: 2;
}

.profile-banner__halo,
.profile-banner__wave {
  position: absolute;
  pointer-events: none;
}

.profile-banner__halo {
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.profile-banner__halo--left {
  bottom: -44rpx;
  left: 74rpx;
  width: 252rpx;
  height: 188rpx;
  transform: rotate(-18deg);
}

.profile-banner__halo--right {
  right: -30rpx;
  bottom: -32rpx;
  width: 290rpx;
  height: 168rpx;
  transform: rotate(-8deg);
}

.profile-banner__wave {
  right: 12rpx;
  bottom: 32rpx;
  left: 214rpx;
  height: 82rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.1);
  border-bottom: 0;
  border-radius: 50% 50% 0 0;
  transform: rotate(-2deg);
}

.profile-banner__wave--two {
  right: 128rpx;
  bottom: 16rpx;
  left: 114rpx;
  opacity: 0.58;
  transform: rotate(3deg);
}

.profile-banner__row {
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.profile-banner__avatar {
  width: 132rpx;
  height: 132rpx;
  flex: 0 0 132rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 18rpx 34rpx rgba(28, 33, 112, 0.24);
  box-sizing: border-box;
}

.profile-banner__info {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
  padding-top: 16rpx;
}

.profile-banner__name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.profile-banner__name {
  max-width: 208rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.08;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-banner__verify {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7b9f 0%, #ff526f 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 32rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 78, 118, 0.32);
}

.profile-banner__intro {
  display: block;
  overflow: hidden;
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-banner__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  overflow: visible;
  margin-top: 28rpx;
}

.profile-banner__tags text {
  flex: 0 0 auto;
  min-width: 76rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.94);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.1;
  text-align: center;
  white-space: nowrap;
}

.profile-banner__edit {
  position: relative;
  width: 166rpx;
  height: 58rpx;
  flex: 0 0 166rpx;
  margin: 20rpx 0 0 12rpx;
  padding: 0 32rpx 0 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 54rpx;
  white-space: nowrap;
}

.profile-banner__edit::after {
  position: absolute;
  top: 50%;
  right: 20rpx;
  width: 15rpx;
  height: 15rpx;
  border: 0;
  border-top: 3rpx solid rgba(255, 255, 255, 0.88);
  border-right: 3rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 0;
  transform: translateY(-50%) rotate(45deg);
  content: "";
}

.stats-card {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  min-height: 162rpx;
  margin: -76rpx 28rpx 0;
  padding: 34rpx 0 28rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 20rpx 46rpx rgba(36, 39, 78, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  box-sizing: border-box;
}

.stats__item {
  text-align: center;
}

.stats__value {
  display: block;
  color: #202238;
  font-size: 43rpx;
  font-weight: 900;
  line-height: 1.03;
}

.stats__label {
  display: block;
  margin-top: 12rpx;
  color: #686f87;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.12;
}

.shortcut-card,
.menu-card {
  margin-right: 28rpx;
  margin-left: 28rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 38rpx rgba(42, 48, 100, 0.07);
}

.shortcut-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  min-height: 156rpx;
  margin-top: 20rpx;
  padding: 28rpx 4rpx 22rpx;
  box-sizing: border-box;
}

.shortcut-card__item {
  display: flex;
  align-items: center;
  min-width: 0;
  flex-direction: column;
}

.shortcut-card__icon {
  width: 62rpx;
  height: 62rpx;
  filter: drop-shadow(0 10rpx 16rpx rgba(68, 72, 120, 0.12));
}

.shortcut-card__label {
  width: 100%;
  overflow: hidden;
  margin-top: 16rpx;
  color: #272b43;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.12;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-card {
  overflow: hidden;
  margin-top: 22rpx;
  padding: 0 34rpx;
}

.menu-card__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 120rpx;
  color: #282c45;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.menu-card__item + .menu-card__item {
  border-top: 1rpx solid #edf0f8;
}

.menu-card__label {
  display: flex;
  align-items: center;
  min-width: 0;
}

.menu-card__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 28rpx;
  flex: 0 0 40rpx;
}

.menu-card__arrow {
  color: #9da3b7;
  font-size: 52rpx;
  font-weight: 400;
  line-height: 1;
}

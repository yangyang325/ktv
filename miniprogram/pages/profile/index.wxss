.profile-page {
  min-height: 100vh;
  overflow: hidden;
  padding-bottom: 196rpx;
  background:
    radial-gradient(circle at 12% 18%, rgba(117, 118, 255, 0.12) 0, rgba(117, 118, 255, 0) 28%),
    linear-gradient(180deg, #fbfcff 0%, #f5f6ff 64%, #ffffff 100%);
  box-sizing: border-box;
}

.profile-shell {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

.profile-banner {
  position: relative;
  min-height: 556rpx;
  margin-top: 0;
  overflow: hidden;
  padding: 204rpx 30rpx 104rpx;
  border-bottom-right-radius: 34rpx;
  border-bottom-left-radius: 34rpx;
  background:
    radial-gradient(circle at 22% 4%, rgba(181, 210, 255, 0.4) 0, rgba(181, 210, 255, 0) 26%),
    radial-gradient(circle at 86% 16%, rgba(255, 159, 230, 0.22) 0, rgba(255, 159, 230, 0) 27%),
    linear-gradient(135deg, #6866ff 0%, #7258ff 48%, #8d54ff 100%);
  box-shadow:
    0 22rpx 56rpx rgba(93, 78, 220, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.28);
  box-sizing: border-box;
  color: #ffffff;
}

.profile-banner__bg {
  position: absolute;
  z-index: 0;
  inset: 0;
  width: 100%;
  height: 100%;
}

.profile-banner::after {
  position: absolute;
  z-index: 1;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(10, 12, 24, 0.18) 0%, rgba(10, 12, 24, 0.04) 46%, rgba(92, 72, 255, 0.24) 100%),
    linear-gradient(90deg, rgba(54, 50, 130, 0.16), rgba(255, 255, 255, 0));
  content: "";
}

.profile-banner__content {
  position: relative;
  z-index: 3;
}

.profile-banner__halo,
.profile-banner__wave {
  position: absolute;
  z-index: 2;
  pointer-events: none;
}

.profile-banner__halo {
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.profile-banner__halo--left {
  bottom: -44rpx;
  left: 74rpx;
  width: 252rpx;
  height: 188rpx;
  transform: rotate(-18deg);
}

.profile-banner__halo--right {
  right: -30rpx;
  bottom: -32rpx;
  width: 290rpx;
  height: 168rpx;
  transform: rotate(-8deg);
}

.profile-banner__wave {
  right: 12rpx;
  bottom: 32rpx;
  left: 214rpx;
  height: 82rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.1);
  border-bottom: 0;
  border-radius: 50% 50% 0 0;
  transform: rotate(-2deg);
}

.profile-banner__wave--two {
  right: 128rpx;
  bottom: 16rpx;
  left: 114rpx;
  opacity: 0.58;
  transform: rotate(3deg);
}

.profile-banner__row {
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.profile-banner__avatar {
  width: 132rpx;
  height: 132rpx;
  flex: 0 0 132rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 18rpx 34rpx rgba(28, 33, 112, 0.24);
  box-sizing: border-box;
}

.profile-banner__info {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
  padding-top: 16rpx;
}

.profile-banner__name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.profile-banner__name {
  max-width: 208rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.08;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-banner__verify {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7b9f 0%, #ff526f 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 32rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 78, 118, 0.32);
}

.profile-banner__intro {
  display: block;
  overflow: hidden;
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-banner__tags {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 12rpx;
  overflow: visible;
  margin: 22rpx 0 0 154rpx;
  white-space: nowrap;
}

.profile-banner__tags text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 76rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.94);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.1;
  text-align: center;
  white-space: nowrap;
}

.profile-banner__edit {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 172rpx;
  height: 58rpx;
  flex: 0 0 172rpx;
  margin: 20rpx 0 0 12rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.profile-banner__edit-icon {
  width: 24rpx;
  height: 24rpx;
  flex: 0 0 24rpx;
  margin-right: 8rpx;
}

.profile-content {
  position: relative;
  z-index: 2;
  min-height: 560rpx;
  margin-top: -74rpx;
  padding: 0 0 196rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: #f6f8ff;
  box-sizing: border-box;
}

.stats-card {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  min-height: 162rpx;
  margin: 0 28rpx;
  padding: 34rpx 0 28rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 20rpx 46rpx rgba(36, 39, 78, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  box-sizing: border-box;
  transform: translateY(-52rpx);
}

.stats__item {
  text-align: center;
}

.stats__value {
  display: block;
  color: #202238;
  font-size: 43rpx;
  font-weight: 900;
  line-height: 1.03;
}

.stats__label {
  display: block;
  margin-top: 12rpx;
  color: #686f87;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.12;
}

.menu-card {
  margin-right: 28rpx;
  margin-left: 28rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 38rpx rgba(42, 48, 100, 0.07);
}

.profile-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: end;
  margin: -20rpx 28rpx 0;
  min-height: 86rpx;
}

.profile-tabs__item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 78rpx;
  color: #7c8292;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.profile-tabs__item--active {
  color: #151722;
  font-size: 38rpx;
  font-weight: 900;
}

.profile-tabs__item--active::after {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 92rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #f0ff4c 0%, #a9ff85 100%);
  transform: translateX(-50%) rotate(-8deg);
  content: "";
}

.profile-tabs__count {
  margin-left: 5rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.profile-party-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin: 24rpx 28rpx 0;
}

.profile-party-card {
  display: flex;
  min-height: 184rpx;
  padding: 14rpx;
  border: 1rpx solid #edf0f7;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 14rpx 34rpx rgba(42, 48, 100, 0.07);
  box-sizing: border-box;
}

.profile-party-card__cover {
  width: 178rpx;
  height: 156rpx;
  flex: 0 0 178rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #edeff7;
}

.profile-party-card__body {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.profile-party-card__header {
  display: flex;
  align-items: center;
  min-width: 0;
}

.profile-party-card__title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #1b1e2f;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-party-card__status {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #eef7ff;
  color: #4288ff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.profile-party-card__tags {
  display: flex;
  height: 32rpx;
  margin-top: 10rpx;
  overflow: hidden;
}

.profile-party-card__tags text {
  display: inline-flex;
  align-items: center;
  height: 30rpx;
  margin-right: 8rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #f0edff;
  color: #735cff;
  font-size: 18rpx;
  font-weight: 800;
  white-space: nowrap;
}

.profile-party-card__meta {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 8rpx;
  color: #7d8497;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.15;
}

.profile-party-card__meta image {
  width: 22rpx;
  height: 22rpx;
  flex: 0 0 22rpx;
  margin-right: 8rpx;
  opacity: 0.62;
}

.profile-party-card__meta text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-party-card__footer {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  color: #6f768a;
  font-size: 22rpx;
  font-weight: 800;
}

.profile-party-card__footer text:last-child {
  color: #ff4f55;
}

.profile-empty {
  display: flex;
  align-items: center;
  min-height: 520rpx;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx 52rpx 96rpx;
  box-sizing: border-box;
}

.profile-empty__scene {
  position: relative;
  width: 240rpx;
  height: 190rpx;
}

.profile-empty__bench {
  position: absolute;
  right: 20rpx;
  bottom: 28rpx;
  left: 22rpx;
  height: 74rpx;
  border-top: 17rpx solid #eadca7;
  border-bottom: 17rpx solid #eadca7;
  box-shadow: 0 28rpx 0 #eadca7;
}

.profile-empty__bench::before,
.profile-empty__bench::after {
  position: absolute;
  bottom: -50rpx;
  width: 12rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #eadca7;
  content: "";
}

.profile-empty__bench::before {
  left: 18rpx;
}

.profile-empty__bench::after {
  right: 18rpx;
}

.profile-empty__face {
  position: absolute;
  top: 0;
  right: 22rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #c8f8ff 0%, #8de7ff 100%);
  box-shadow: 0 18rpx 36rpx rgba(92, 206, 225, 0.18);
}

.profile-empty__eye {
  position: absolute;
  top: 50rpx;
  width: 18rpx;
  height: 10rpx;
  border-bottom: 6rpx solid #536677;
  border-radius: 0 0 999rpx 999rpx;
}

.profile-empty__eye--left {
  left: 38rpx;
}

.profile-empty__eye--right {
  right: 38rpx;
}

.profile-empty__mouth {
  position: absolute;
  left: 44rpx;
  bottom: 34rpx;
  width: 40rpx;
  height: 18rpx;
  border-bottom: 6rpx solid #536677;
  border-radius: 0 0 999rpx 999rpx;
}

.profile-empty__dot {
  position: absolute;
  left: 74rpx;
  bottom: 58rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f8ef83;
}

.profile-empty__dot::before,
.profile-empty__dot::after {
  position: absolute;
  top: 12rpx;
  width: 5rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #6a684e;
  content: "";
}

.profile-empty__dot::before {
  left: 12rpx;
}

.profile-empty__dot::after {
  right: 12rpx;
}

.profile-empty__title {
  margin-top: 26rpx;
  color: #3e4351;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.profile-empty__desc {
  max-width: 460rpx;
  margin-top: 12rpx;
  color: #8c93a3;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: center;
}

.menu-card {
  overflow: hidden;
  margin-top: 22rpx;
  padding: 0 34rpx;
}

.menu-card__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 120rpx;
  color: #282c45;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.menu-card__item + .menu-card__item {
  border-top: 1rpx solid #edf0f8;
}

.menu-card__label {
  display: flex;
  align-items: center;
  min-width: 0;
}

.menu-card__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 28rpx;
  flex: 0 0 40rpx;
}

.menu-card__arrow {
  color: #9da3b7;
  font-size: 52rpx;
  font-weight: 400;
  line-height: 1;
}

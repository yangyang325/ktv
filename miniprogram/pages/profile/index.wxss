.profile-page {
  min-height: 100vh;
  overflow: hidden;
  padding-bottom: 196rpx;
  background:
    radial-gradient(circle at 12% 18%, rgba(117, 118, 255, 0.12) 0, rgba(117, 118, 255, 0) 28%),
    linear-gradient(180deg, #fbfcff 0%, #f5f6ff 64%, #ffffff 100%);
  box-sizing: border-box;
}

.profile-shell {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

.profile-banner {
  position: relative;
  min-height: 556rpx;
  margin-top: 0;
  overflow: hidden;
  padding: 204rpx 30rpx 104rpx;
  border-bottom-right-radius: 34rpx;
  border-bottom-left-radius: 34rpx;
  background:
    radial-gradient(circle at 22% 4%, rgba(181, 210, 255, 0.4) 0, rgba(181, 210, 255, 0) 26%),
    radial-gradient(circle at 86% 16%, rgba(255, 159, 230, 0.22) 0, rgba(255, 159, 230, 0) 27%),
    linear-gradient(135deg, #6866ff 0%, #7258ff 48%, #8d54ff 100%);
  box-shadow:
    0 22rpx 56rpx rgba(93, 78, 220, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.28);
  box-sizing: border-box;
  color: #ffffff;
}

.profile-banner__bg {
  position: absolute;
  z-index: 0;
  inset: 0;
  width: 100%;
  height: 100%;
}

.profile-banner::after {
  position: absolute;
  z-index: 1;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(10, 12, 24, 0.18) 0%, rgba(10, 12, 24, 0.04) 46%, rgba(92, 72, 255, 0.24) 100%),
    linear-gradient(90deg, rgba(54, 50, 130, 0.16), rgba(255, 255, 255, 0));
  content: "";
}

.profile-banner__content {
  position: relative;
  z-index: 3;
}

.profile-banner__halo,
.profile-banner__wave {
  position: absolute;
  z-index: 2;
  pointer-events: none;
}

.profile-banner__halo {
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.profile-banner__halo--left {
  bottom: -44rpx;
  left: 74rpx;
  width: 252rpx;
  height: 188rpx;
  transform: rotate(-18deg);
}

.profile-banner__halo--right {
  right: -30rpx;
  bottom: -32rpx;
  width: 290rpx;
  height: 168rpx;
  transform: rotate(-8deg);
}

.profile-banner__wave {
  right: 12rpx;
  bottom: 32rpx;
  left: 214rpx;
  height: 82rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.1);
  border-bottom: 0;
  border-radius: 50% 50% 0 0;
  transform: rotate(-2deg);
}

.profile-banner__wave--two {
  right: 128rpx;
  bottom: 16rpx;
  left: 114rpx;
  opacity: 0.58;
  transform: rotate(3deg);
}

.profile-banner__row {
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.profile-banner__avatar {
  width: 132rpx;
  height: 132rpx;
  flex: 0 0 132rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 18rpx 34rpx rgba(28, 33, 112, 0.24);
  box-sizing: border-box;
}

.profile-banner__info {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
  padding-top: 16rpx;
}

.profile-banner__name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.profile-banner__name {
  max-width: 208rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.08;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-banner__verify {
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  margin-left: 14rpx;
}

.profile-banner__intro {
  display: block;
  overflow: hidden;
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-banner__edit {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 58rpx;
  flex: 0 0 144rpx;
  margin: 20rpx 0 0 12rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.profile-content {
  position: relative;
  z-index: 2;
  min-height: 560rpx;
  margin-top: -74rpx;
  padding: 0 0 196rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: #f6f8ff;
  box-sizing: border-box;
}

.stats-card {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  min-height: 162rpx;
  margin: 0 28rpx;
  padding: 34rpx 0 28rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 20rpx 46rpx rgba(36, 39, 78, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  box-sizing: border-box;
  transform: translateY(-52rpx);
}

.stats__item {
  text-align: center;
}

.stats__item--tap {
  cursor: pointer;
}

.stats__item--tap:active {
  opacity: 0.72;
}

.stats__value {
  display: block;
  color: #202238;
  font-size: 43rpx;
  font-weight: 900;
  line-height: 1.03;
}

.stats__label {
  display: block;
  margin-top: 12rpx;
  color: #686f87;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.12;
}

.profile-section-card {
  margin: -24rpx 28rpx 0;
  padding: 28rpx 28rpx 30rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 38rpx rgba(42, 48, 100, 0.07);
  box-sizing: border-box;
}

.profile-section-card + .profile-section-card,
.profile-section-card + .menu-card {
  margin-top: 24rpx;
}

.profile-tags-card,
.profile-achievement-card {
  overflow: hidden;
}

.profile-section-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  margin-bottom: 26rpx;
}

.profile-section-card__title {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
  color: #171b2d;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.1;
}

.profile-section-card__icon {
  display: block;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  margin-right: 20rpx;
}

.profile-section-card__link {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  height: 46rpx;
  flex: 0 0 auto;
  margin: 0 0 0 auto;
  padding: 0;
  background: transparent;
  color: #747b91;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.profile-section-card__link::after {
  border: 0;
}

.profile-section-card__arrow {
  margin-left: 8rpx;
  color: #9aa1b3;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1;
}

.profile-tags-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
}

.profile-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 62rpx;
  overflow: hidden;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-tag--purple {
  background: linear-gradient(135deg, #f5edff 0%, #efe8ff 100%);
  color: #6b40ff;
}

.profile-tag--blue {
  background: linear-gradient(135deg, #eef8ff 0%, #e8f2ff 100%);
  color: #2287de;
}

.profile-tag--green {
  background: linear-gradient(135deg, #edf9f3 0%, #e6f8f4 100%);
  color: #0f9c76;
}

.profile-tag--orange {
  background: linear-gradient(135deg, #fff6eb 0%, #fff0e1 100%);
  color: #ec7a00;
}

.profile-tag--pink {
  background: linear-gradient(135deg, #fff0f8 0%, #ffe8f4 100%);
  color: #e13b8d;
}

.profile-tags-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  border-radius: 18rpx;
  background: #f6f7ff;
  color: #8a91a6;
  font-size: 24rpx;
  font-weight: 700;
}

.profile-achievement-list {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
}

.profile-achievement {
  min-width: 0;
  min-height: 212rpx;
  padding: 18rpx 8rpx 20rpx;
  border: 1rpx solid rgba(112, 79, 255, 0.14);
  border-radius: 18rpx;
  background: linear-gradient(180deg, #fbf8ff 0%, #f6f1ff 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  text-align: center;
  box-sizing: border-box;
}

.profile-achievement--purple {
  border-color: rgba(112, 79, 255, 0.18);
  background: linear-gradient(180deg, #fbf8ff 0%, #f4efff 100%);
}

.profile-achievement--gold {
  border-color: rgba(242, 159, 35, 0.18);
  background: linear-gradient(180deg, #fffaf4 0%, #fff3e6 100%);
}

.profile-achievement--blue {
  border-color: rgba(60, 147, 255, 0.18);
  background: linear-gradient(180deg, #f8fbff 0%, #edf6ff 100%);
}

.profile-achievement--pink {
  border-color: rgba(236, 83, 151, 0.18);
  background: linear-gradient(180deg, #fff8fb 0%, #ffedf5 100%);
}

.profile-achievement__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 15rpx;
  background: transparent;
}

.profile-achievement__icon {
  display: block;
  width: 104rpx;
  height: 104rpx;
}

.profile-achievement--locked {
  opacity: 0.48;
}

.profile-achievement__title,
.profile-achievement__desc {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-achievement__title {
  color: #202238;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.1;
}

.profile-achievement__desc {
  margin-top: 10rpx;
  color: #747b91;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.1;
}

.menu-card {
  margin-right: 28rpx;
  margin-left: 28rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 38rpx rgba(42, 48, 100, 0.07);
}

.menu-card {
  overflow: hidden;
  margin-top: 22rpx;
  padding: 0 34rpx;
}

.menu-card__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 120rpx;
  color: #282c45;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.menu-card__item + .menu-card__item {
  border-top: 1rpx solid #edf0f8;
}

.menu-card__label {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.menu-card__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 28rpx;
  flex: 0 0 40rpx;
}

.menu-card__text {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.menu-card__title {
  overflow: hidden;
  color: #282c45;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-card__desc {
  overflow: hidden;
  margin-top: 10rpx;
  color: #747b91;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-card__action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 78rpx;
  height: 48rpx;
  flex: 0 0 auto;
  margin-left: 24rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f1efff;
  color: #6048ff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.messages-page {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  padding: 104rpx 32rpx 200rpx;
  background:
    radial-gradient(circle at 12% 9%, rgba(255, 255, 255, 0.98) 0, rgba(255, 255, 255, 0) 36%),
    linear-gradient(180deg, #fbfcff 0%, #f7f8ff 52%, #ffffff 100%);
}

.messages-page__halo {
  position: absolute;
  z-index: 0;
  width: 300rpx;
  height: 300rpx;
  border-radius: 999rpx;
  filter: blur(24rpx);
  opacity: 0.46;
  pointer-events: none;
}

.messages-page__halo--left {
  top: 160rpx;
  left: -140rpx;
  background: rgba(112, 184, 255, 0.22);
}

.messages-page__halo--right {
  top: 30rpx;
  right: -120rpx;
  background: rgba(255, 139, 184, 0.18);
}

.messages-nav,
.message-tabs,
.conversation-card {
  position: relative;
  z-index: 1;
}

.messages-empty {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 90rpx;
  flex-direction: column;
  text-align: center;
}

.messages-empty__title {
  color: #202235;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.4;
}

.messages-empty__desc {
  width: 520rpx;
  margin-top: 18rpx;
  color: #7f879a;
  font-size: 25rpx;
  line-height: 1.7;
}

.messages-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.messages-nav__title {
  color: #050713;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.message-tabs {
  display: flex;
  justify-content: center;
  gap: 124rpx;
  margin-top: 54rpx;
}

.message-tabs__item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 70rpx;
  height: 56rpx;
  color: #8e94ab;
  font-size: 31rpx;
  font-weight: 800;
}

.message-tabs__item--active {
  color: #5c45ff;
}

.message-tabs__item--active::after {
  position: absolute;
  right: 16rpx;
  bottom: 0;
  left: 16rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7c5cff, #4a35ff);
  content: "";
  box-shadow: 0 8rpx 16rpx rgba(91, 70, 255, 0.28);
}

.message-tabs__dot {
  position: absolute;
  top: 3rpx;
  right: -14rpx;
  width: 15rpx;
  height: 15rpx;
  border-radius: 999rpx;
  background: #ff1238;
}

.conversation-card {
  overflow: hidden;
  margin-top: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 54rpx rgba(48, 55, 105, 0.07);
}

.conversation {
  display: flex;
  align-items: center;
  min-height: 128rpx;
  padding: 17rpx 30rpx;
  box-sizing: border-box;
}

.conversation + .conversation {
  border-top: 1rpx solid #eceff6;
}

.conversation__avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  margin-right: 28rpx;
  flex: 0 0 82rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.conversation__avatar--single,
.conversation__avatar--group {
  overflow: hidden;
  background: #eef0f5;
}

.conversation__avatar--notice {
  background: linear-gradient(140deg, #845cff 0%, #5a43ef 100%);
  box-shadow: inset 14rpx 16rpx 30rpx rgba(255, 255, 255, 0.2);
}

.conversation__avatar--activity {
  background: linear-gradient(140deg, #62beff 0%, #1679f2 100%);
  box-shadow: inset 14rpx 16rpx 30rpx rgba(255, 255, 255, 0.24);
}

.portrait {
  position: absolute;
  width: 82rpx;
  height: 82rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #f7d6c3 0%, #f2bda3 100%);
}

.portrait--warm {
  background: linear-gradient(180deg, #f3c3a7 0%, #dfa080 100%);
}

.portrait--rose {
  background: linear-gradient(180deg, #f0c4bd 0%, #da978f 100%);
}

.portrait--fair {
  background: linear-gradient(180deg, #ffd9c8 0%, #f1b598 100%);
}

.portrait--peach {
  background: linear-gradient(180deg, #f8c9ad 0%, #e59c76 100%);
}

.portrait--mini {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #ffffff;
}

.portrait--slot-0 {
  top: 8rpx;
  left: 9rpx;
}

.portrait--slot-1 {
  top: 8rpx;
  right: 9rpx;
}

.portrait--slot-2 {
  bottom: 8rpx;
  left: 9rpx;
}

.portrait--slot-3 {
  right: 9rpx;
  bottom: 8rpx;
}

.portrait__hair {
  position: absolute;
  top: -3rpx;
  right: 12rpx;
  left: 12rpx;
  height: 36rpx;
  border-radius: 30rpx 30rpx 12rpx 12rpx;
  background: #18131b;
}

.portrait__hair::before,
.portrait__hair::after {
  position: absolute;
  top: 13rpx;
  width: 14rpx;
  height: 38rpx;
  border-radius: 999rpx;
  background: #18131b;
  content: "";
}

.portrait__hair::before {
  left: -8rpx;
  transform: rotate(12deg);
}

.portrait__hair::after {
  right: -8rpx;
  transform: rotate(-12deg);
}

.portrait__face {
  position: absolute;
  top: 21rpx;
  left: 22rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 999rpx;
  background:
    radial-gradient(circle at 13rpx 16rpx, #1c1b24 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 25rpx 16rpx, #1c1b24 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 19rpx 27rpx, #e06f78 0 5rpx, transparent 6rpx),
    #ffd9c6;
}

.portrait__body {
  position: absolute;
  right: 14rpx;
  bottom: -7rpx;
  left: 14rpx;
  height: 29rpx;
  border-radius: 20rpx 20rpx 0 0;
  background: #ffffff;
}

.portrait--blue .portrait__body {
  background: #75b8ff;
}

.portrait--pink .portrait__body {
  background: #f3a5c7;
}

.portrait--dark .portrait__body {
  background: #1f2430;
}

.conversation__online {
  position: absolute;
  right: -2rpx;
  bottom: 3rpx;
  width: 19rpx;
  height: 19rpx;
  border: 5rpx solid #ffffff;
  border-radius: 999rpx;
  background: #25d873;
}

.notice-bell {
  position: relative;
  width: 45rpx;
  height: 50rpx;
}

.notice-bell__cap {
  position: absolute;
  top: 0;
  left: 17rpx;
  width: 11rpx;
  height: 13rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: #ffffff;
}

.notice-bell__body {
  position: absolute;
  top: 12rpx;
  left: 6rpx;
  width: 33rpx;
  height: 30rpx;
  border-radius: 24rpx 24rpx 10rpx 10rpx;
  background: #ffffff;
}

.notice-bell__foot {
  position: absolute;
  bottom: 0;
  left: 2rpx;
  width: 41rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.activity-mail {
  position: relative;
  width: 47rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.activity-mail::before,
.activity-mail::after {
  position: absolute;
  top: 0;
  width: 28rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #ffffff;
  content: "";
}

.activity-mail::before {
  left: 2rpx;
  transform: rotate(35deg);
  transform-origin: left center;
}

.activity-mail::after {
  right: 2rpx;
  transform: rotate(-35deg);
  transform-origin: right center;
}

.activity-mail__flap {
  position: absolute;
  top: 11rpx;
  left: 8rpx;
  width: 31rpx;
  height: 16rpx;
  border: 5rpx solid #4c9cf7;
  border-top: 0;
  border-left: 0;
  transform: rotate(45deg);
}

.activity-mail__check {
  position: absolute;
  right: 13rpx;
  bottom: 11rpx;
  width: 20rpx;
  height: 11rpx;
  border: 6rpx solid #4c9cf7;
  border-top: 0;
  border-right: 0;
  transform: rotate(-45deg);
}

.conversation__content {
  min-width: 0;
  flex: 1;
}

.conversation__top,
.conversation__bottom,
.conversation__title-wrap {
  display: flex;
  align-items: center;
  min-width: 0;
}

.conversation__title-wrap {
  max-width: 410rpx;
  flex: 1;
}

.conversation__title {
  overflow: hidden;
  color: #111425;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation__role {
  margin-left: 12rpx;
  flex: 0 0 auto;
  color: #6b55ff;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.2;
}

.conversation__role--official {
  padding: 3rpx 8rpx;
  border-radius: 7rpx;
  background: #eeeaff;
  color: #5c45ff;
  font-size: 21rpx;
}

.conversation__time {
  margin-left: 18rpx;
  flex: 0 0 auto;
  color: #9197ae;
  font-size: 24rpx;
  font-weight: 500;
}

.conversation__bottom {
  margin-top: 18rpx;
}

.conversation__preview {
  overflow: hidden;
  flex: 1;
  color: #8a90a9;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 34rpx;
  height: 34rpx;
  margin-left: 18rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ff061c;
  box-shadow: 0 8rpx 14rpx rgba(255, 6, 28, 0.22);
  box-sizing: border-box;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.home-page {
  background: #f6f8ff;
}

.hero {
  position: relative;
  min-height: 538rpx;
  padding: 108rpx 42rpx 156rpx;
  overflow: hidden;
  background: linear-gradient(142deg, #5c7cff 0%, #704dff 54%, #8f7bff 100%);
  box-sizing: border-box;
  color: #ffffff;
}

.hero__art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero::after {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(82, 111, 255, 0.1), rgba(115, 75, 255, 0.02)),
    linear-gradient(180deg, rgba(24, 34, 140, 0.04), rgba(86, 70, 255, 0.14));
  content: "";
}

.hero__top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.hero__city {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 54rpx;
  padding: 0 16rpx 0 0;
  font-size: 30rpx;
  font-weight: 700;
}

.hero__city-icon {
  width: 30rpx;
  height: 30rpx;
  filter: brightness(0) invert(1);
}

.hero__city-arrow {
  display: block;
  width: 11rpx;
  height: 11rpx;
  margin-top: -5rpx;
  box-sizing: border-box;
  border-right: 3rpx solid rgba(255, 255, 255, 0.94);
  border-bottom: 3rpx solid rgba(255, 255, 255, 0.94);
  transform: rotate(45deg);
}

.hero__title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 54rpx;
  font-size: 72rpx;
  line-height: 1.3;
  font-weight: 900;
}

.hero__desc {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.hero__points {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 26rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
}

.hero__points text {
  display: inline-flex;
  align-items: center;
}

.hero__points text::before {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 50%;
  content: "";
}

.home-content {
  position: relative;
  z-index: 2;
  min-height: 520rpx;
  margin-top: -74rpx;
  padding: 0 28rpx 190rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: #f6f8ff;
  box-sizing: border-box;
}

.quick-panel {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  transform: translateY(-52rpx);
  padding: 42rpx 16rpx 34rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow:
    0 28rpx 60rpx rgba(52, 59, 120, 0.16),
    0 8rpx 22rpx rgba(107, 76, 255, 0.08);
  box-sizing: border-box;
}

.quick-panel__item {
  display: flex;
  align-items: center;
  min-width: 0;
  flex-direction: column;
}

.quick-panel__icon {
  width: 112rpx;
  height: 112rpx;
  filter: drop-shadow(0 12rpx 22rpx rgba(107, 76, 255, 0.18));
}

.quick-panel__title {
  width: 112rpx;
  margin-top: 16rpx;
  color: #202333;
  font-size: 27rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
}

.quick-panel__desc {
  margin-top: 6rpx;
  color: #9aa1b2;
  font-size: 22rpx;
  white-space: nowrap;
}

.section {
  margin-top: -16rpx;
}

.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section__title {
  color: #202333;
  font-size: 34rpx;
  font-weight: 900;
}

.section__more {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 48rpx;
  padding-left: 18rpx;
  color: #a2a8b8;
  font-size: 25rpx;
  font-weight: 700;
}

.section__more-arrow {
  display: block;
  width: 12rpx;
  height: 12rpx;
  box-sizing: border-box;
  border-right: 3rpx solid #a2a8b8;
  border-bottom: 3rpx solid #a2a8b8;
  transform: rotate(-45deg);
}

.home-page {
  padding: 0 22rpx 36rpx;
}

.hero {
  position: relative;
  min-height: 430rpx;
  margin: 0 -22rpx;
  padding: 42rpx 42rpx 88rpx;
  overflow: hidden;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background:
    radial-gradient(circle at 78% 34%, rgba(255, 255, 255, 0.28) 0, transparent 24%),
    linear-gradient(142deg, #5c7cff 0%, #704dff 54%, #8f7bff 100%);
  box-sizing: border-box;
  color: #ffffff;
}

.hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero__city {
  font-size: 30rpx;
  font-weight: 700;
}

.hero__capsule {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-weight: 700;
}

.hero__title {
  display: block;
  margin-top: 64rpx;
  font-size: 70rpx;
  line-height: 1.3;
  font-weight: 900;
}

.hero__desc {
  display: block;
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.hero__points {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  margin-top: 28rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
}

.hero__mic {
  position: absolute;
  right: 74rpx;
  top: 138rpx;
  color: rgba(255, 225, 135, 0.95);
  font-size: 130rpx;
  font-weight: 900;
  transform: rotate(16deg);
}

.quick-panel {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: -56rpx;
  padding: 32rpx 16rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: var(--shadow-soft);
}

.quick-panel__item {
  display: flex;
  align-items: center;
  min-width: 0;
  flex-direction: column;
}

.quick-panel__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #7d66ff, #4f3bdb);
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 26rpx rgba(107, 76, 255, 0.24);
}

.quick-panel__icon--discover {
  background: linear-gradient(135deg, #ffba57, #ff7d2b);
}

.quick-panel__icon--mine {
  background: linear-gradient(135deg, #53df8f, #23c473);
}

.quick-panel__icon--favorites {
  background: linear-gradient(135deg, #66c5ff, #4b8dff);
}

.quick-panel__title {
  margin-top: 16rpx;
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 800;
  white-space: nowrap;
}

.quick-panel__desc {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
  white-space: nowrap;
}

.section {
  margin-top: 34rpx;
}

.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section__title {
  font-size: 34rpx;
  font-weight: 900;
}

.section__more {
  color: var(--text-secondary);
  font-size: 25rpx;
}

.home-page {
  padding: 24rpx;
}

.hero {
  padding: 40rpx 32rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #ffd3a5 0%, #ffedd4 50%, #fff8ef 100%);
}

.hero__title {
  display: block;
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 700;
}

.hero__desc {
  display: block;
  margin-top: 16rpx;
  color: var(--text-secondary);
}

.section {
  margin-top: 24rpx;
}

.section__title {
  font-size: 30rpx;
  font-weight: 600;
}

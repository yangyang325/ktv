<view class="page home-page">
  <view class="hero">
    <image
      class="hero__art"
      src="/assets/images/ktv/home-hero-microphone.jpg"
      mode="aspectFill"
    />
    <view class="hero__top">
      <view class="hero__city" bindtap="handleCityTap">
        <image class="hero__city-icon" src="/assets/images/ktv/location_selected.svg" mode="aspectFit" />
        <text>{{cityName}}</text>
        <text class="hero__city-arrow">⌄</text>
      </view>
    </view>
    <text class="hero__title">KTV组局</text>
    <text class="hero__desc">一起嗨唱，快乐翻倍！</text>
    <view class="hero__points">
      <text>认识新朋友</text>
      <text>丰富业余生活</text>
      <text>轻松组局</text>
    </view>
  </view>

  <view class="home-content">
    <view class="quick-panel">
      <view
        wx:for="{{actions}}"
        wx:key="key"
        class="quick-panel__item"
        data-key="{{item.key}}"
        bindtap="handleActionTap"
      >
        <image class="quick-panel__icon" src="{{item.iconUrl}}" mode="aspectFit" />
        <text class="quick-panel__title">{{item.title}}</text>
        <text class="quick-panel__desc">{{item.desc}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section__header">
        <text class="section__title">热门推荐</text>
        <text class="section__more">查看更多 ›</text>
      </view>
      <party-card wx:for="{{partyList}}" wx:key="partyId" party="{{item}}" />
    </view>
  </view>
</view>

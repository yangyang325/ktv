<view class="page home-page">
  <view class="hero">
    <image
      class="hero__art"
      src="https://wechatapppro-1252524126.cdn.xiaoeknow.com/appbtajnbm33436/image/b_u_616d1cc7eabb6_eanzXeE6/owam8ampgllwoo.jpg"
      mode="aspectFill"
    />
    <view class="hero__top">
      <view class="hero__city" bindtap="handleCityTap">
        <image class="hero__city-icon" src="/assets/images/ktv/location.svg" mode="aspectFit" />
        <text>{{cityPicking ? '选择中' : cityName}}</text>
        <text class="hero__city-arrow"></text>
      </view>
    </view>
    <text class="hero__title">K歌兴趣活动</text>
    <text class="hero__desc">记录活动时间地点，线下自主参与</text>
    <view class="hero__points">
      <text>兴趣活动</text>
      <text>AA参考</text>
      <text>活动信息</text>
    </view>
  </view>

  <view class="home-content">
    <view class="quick-panel">
      <view
        wx:for="{{actions}}"
        wx:key="key"
        class="quick-panel__item"
        data-key="{{item.key}}"
        bindtap="handleActionTap"
      >
        <image class="quick-panel__icon" src="{{item.iconUrl}}" mode="aspectFit" />
        <text class="quick-panel__title">{{item.title}}</text>
        <text class="quick-panel__desc">{{item.desc}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section__header">
        <text class="section__title">热门推荐</text>
        <view class="section__more" bindtap="handleMoreTap">
          <text>查看更多</text>
          <text class="section__more-arrow"></text>
        </view>
      </view>
      <party-card wx:for="{{partyList}}" wx:key="partyId" party="{{item}}" />
    </view>
  </view>
</view>

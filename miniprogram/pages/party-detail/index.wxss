.detail-page {
  min-height: 100vh;
  padding: 14rpx 0 calc(154rpx + env(safe-area-inset-bottom));
  background: #f7f7fb;
}

.detail-row__copy {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1;
}

.detail-row__copy::after,
.host__follow::after,
.actions__favorite::after,
.actions__share::after,
.actions__status::after,
.actions__primary::after {
  border: 0;
}

.detail-shell,
.detail-section {
  margin-right: 14rpx;
  margin-left: 14rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(36, 38, 64, 0.05);
}

.detail-shell {
  overflow: hidden;
}

.detail-hero {
  position: relative;
  height: 386rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 16%, rgba(245, 49, 255, 0.5) 0, transparent 25%),
    radial-gradient(circle at 78% 45%, rgba(87, 67, 255, 0.42) 0, transparent 31%),
    linear-gradient(145deg, #160f28 0%, #05030a 100%);
}

.detail-hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.detail-hero::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(10, 8, 20, 0.04), rgba(10, 8, 20, 0.2));
  content: "";
}

.detail-hero__status {
  position: absolute;
  z-index: 2;
  top: 18rpx;
  left: 18rpx;
  padding: 8rpx 15rpx;
  border-radius: 8rpx;
  background: #16c878;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
}

.detail-hero__status--signup {
  background: #16c878;
}

.detail-hero__status--active {
  background: #2497ff;
}

.detail-hero__status--full {
  background: #ff982b;
}

.detail-hero__status--finished {
  background: rgba(25, 27, 42, 0.72);
}

.detail-card {
  padding: 26rpx 28rpx 8rpx;
  background: #ffffff;
}

.detail-card__title {
  display: block;
  color: #222637;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.detail-card__desc {
  display: block;
  margin-top: 12rpx;
  color: #9399a8;
  font-size: 25rpx;
  line-height: 1.45;
}

.detail-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #eef0f6;
}

.detail-card__tag {
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  background: #f1efff;
  color: #6048ff;
  font-size: 23rpx;
  font-weight: 800;
}

.detail-info {
  padding: 4rpx 0 2rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 78rpx;
  padding: 17rpx 0;
}

.detail-row__icon {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  opacity: 0.88;
}

.detail-row__body {
  min-width: 0;
  flex: 1;
}

.detail-row__main,
.detail-row__sub {
  display: block;
}

.detail-row__main {
  overflow: hidden;
  color: #252938;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-row__sub {
  margin-top: 7rpx;
  color: #9aa0ae;
  font-size: 24rpx;
  line-height: 1.35;
}

.detail-row__price-value {
  color: #ff443f;
  font-weight: 900;
}

.detail-row__progress-current {
  color: #6048ff;
  font-weight: 900;
}

.detail-row__progress-separator {
  color: #252938;
  font-weight: 900;
}

.detail-row__progress-total {
  color: #252938;
  font-weight: 900;
}

.detail-row__progress-current--full {
  color: #ff982b;
}

.detail-row__progress-separator--full {
  color: #ff982b;
}

.detail-row__progress-total--full {
  color: #ff982b;
}

.detail-row__remaining-value {
  color: #6048ff;
  font-weight: 900;
}

.detail-row__copy {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 44rpx;
  flex: 0 0 112rpx;
  border-radius: 999rpx;
  background: #f0ebff;
  color: #6b4cff;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-section {
  margin-top: 18rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.detail-section--intro {
  padding-bottom: 32rpx;
}

.detail-section__title {
  display: block;
  margin-bottom: 22rpx;
  color: #252938;
  font-size: 28rpx;
  font-weight: 900;
}

.host {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.host__avatar {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 50%;
  background: #ffe1d6;
}

.host__body {
  min-width: 0;
  flex: 1;
}

.host__name-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.host__name {
  color: #252938;
  font-size: 28rpx;
  font-weight: 900;
}

.host__intro,
.detail-section__text {
  display: block;
  color: #8e95a6;
  font-size: 25rpx;
  line-height: 1.6;
}

.host__intro {
  margin-top: 5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.host__follow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 50rpx;
  flex: 0 0 112rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid #6b4cff;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6048ff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 46rpx;
}

.host__follow--active {
  border-color: #ece7ff;
  background: #f1efff;
  color: #6048ff;
}

.host__follow[disabled] {
  color: #6048ff;
  opacity: 1;
}

.detail-section__text {
  color: #303445;
  font-weight: 700;
}

.actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -12rpx 30rpx rgba(30, 35, 70, 0.07);
  box-sizing: border-box;
}

.actions__favorite {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 70rpx;
  height: 82rpx;
  min-width: 70rpx;
  max-width: 70rpx;
  flex: 0 0 70rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #303445;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
}

.actions__favorite image {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 4rpx;
}

.actions__favorite--active {
  color: #6048ff;
  font-weight: 900;
}

.actions__favorite--active image {
  filter: drop-shadow(0 0 8rpx rgba(255, 184, 0, 0.3));
}

.actions__share {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 82rpx;
  min-width: 168rpx;
  max-width: 168rpx;
  flex: 0 0 168rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid #6b4cff;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
  color: #6048ff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.actions__primary {
  width: 0;
  min-width: 0;
  height: 82rpx;
  flex: 1 1 0;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 82rpx;
  text-align: center;
}

.actions__status {
  width: 168rpx;
  min-width: 168rpx;
  height: 82rpx;
  flex: 0 0 168rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid #6b4cff;
  border-radius: 16rpx;
  box-sizing: border-box;
  color: #6048ff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 78rpx;
  text-align: center;
}

.actions__primary {
  background: linear-gradient(135deg, #8a69ff 0%, #593af2 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(100, 70, 255, 0.28);
}

.actions__primary--danger {
  background: linear-gradient(135deg, #ff7b72 0%, #ff443f 100%);
  box-shadow: 0 14rpx 30rpx rgba(255, 68, 63, 0.22);
}

.actions__primary--waitlist {
  background: linear-gradient(135deg, #ffb84d 0%, #ff8a1f 100%);
  box-shadow: 0 14rpx 30rpx rgba(255, 138, 31, 0.22);
}

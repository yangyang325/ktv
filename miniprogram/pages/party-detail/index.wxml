<view class="page detail-page">
  <block wx:if="{{detail}}">
    <view class="detail-shell">
      <view class="detail-hero">
        <image
          wx:if="{{detail.party.coverImage}}"
          class="detail-hero__image"
          src="{{detail.party.coverImage}}"
          mode="aspectFill"
        />
        <text class="detail-hero__status detail-hero__status--{{statusTone}}">{{detail.party.statusText}}</text>
      </view>

      <view class="detail-card">
        <text class="detail-card__title">{{detail.party.title}}</text>
        <text class="detail-card__desc">K歌兴趣活动信息展示，线下自主确认参与。</text>
        <view class="detail-card__tags">
          <text
            class="detail-card__tag"
            wx:for="{{displayTags}}"
            wx:key="label"
          >{{item.label}}</text>
        </view>

        <view class="detail-info">
          <view class="detail-row">
            <image class="detail-row__icon" src="/assets/images/ktv/clock.svg" mode="aspectFit" />
            <view class="detail-row__body">
              <text class="detail-row__main">{{detail.party.timeSummary}}（预计{{durationHourText}}小时）</text>
            </view>
          </view>
          <view class="detail-row">
            <image class="detail-row__icon" src="/assets/images/ktv/location.svg" mode="aspectFit" />
            <view class="detail-row__body">
              <text class="detail-row__main">{{detail.party.venueSummary}}</text>
              <text wx:if="{{detail.party.venueAddress}}" class="detail-row__sub">{{detail.party.venueAddress}}</text>
              <text wx:else class="detail-row__sub">地址以发起人现场通知为准</text>
            </view>
            <button class="detail-row__copy" hover-class="none" bindtap="handleCopyVenueLocation">
              <text>复制地点</text>
            </button>
          </view>
          <view class="detail-row">
            <image class="detail-row__icon" src="/assets/images/ktv/yen.svg" mode="aspectFit" />
            <view class="detail-row__body">
              <text class="detail-row__main">AA参考 · 预计 <text class="detail-row__price-value">{{detail.party.priceText}}</text></text>
              <text class="detail-row__sub">仅作线下AA参考，小程序不收款</text>
            </view>
          </view>
          <view class="detail-row">
            <image class="detail-row__icon" src="/assets/images/ktv/users.svg" mode="aspectFit" />
            <view class="detail-row__body">
              <text class="detail-row__main">
                <text class="detail-row__progress-current {{remainingCount === 0 ? 'detail-row__progress-current--full' : ''}}">{{detail.party.confirmedCount}}</text>
                <text class="detail-row__progress-separator {{remainingCount === 0 ? 'detail-row__progress-separator--full' : ''}}">/</text>
                <text class="detail-row__progress-total {{remainingCount === 0 ? 'detail-row__progress-total--full' : ''}}">{{detail.party.maxCapacity}}</text>
                <text>人</text>
              </text>
              <text class="detail-row__sub">剩余 <text class="detail-row__remaining-value">{{remainingCount}}</text> 个活动名额</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="detail-section">
      <text class="detail-section__title">发起人</text>
      <view class="host host--tapable" bindtap="handleOpenHostProfile">
        <image wx:if="{{detail.host.avatarUrl}}" class="host__avatar" src="{{detail.host.avatarUrl}}" mode="aspectFill" />
        <image wx:else class="host__avatar" src="{{defaultHostAvatarUrl}}" mode="aspectFill" />
        <view class="host__body">
          <view class="host__name-line">
            <text class="host__name">{{detail.host.nickname}}</text>
          </view>
          <text class="host__intro">K歌爱好者，活动信息由发起人自行维护。</text>
        </view>
        <button
          wx:if="{{canFollowHost}}"
          class="host__follow {{(isFollowingHost || followSubmitting) ? 'host__follow--active' : ''}}"
          hover-class="none"
          disabled="{{followSubmitting}}"
          catchtap="handleFollowHostTap"
        >{{followSubmitting ? '处理中' : (isFollowingHost ? '已关注' : '关注')}}</button>
      </view>
    </view>

    <view class="detail-section detail-section--intro">
      <text class="detail-section__title">活动介绍</text>
      <text class="detail-section__text">{{detail.party.notes}}</text>
    </view>

    <view class="actions">
      <button
        class="actions__favorite {{isFavorited ? 'actions__favorite--active' : ''}}"
        hover-class="none"
        disabled="{{favoriteSubmitting}}"
        bindtap="handleFavoriteTap"
      >
        <image src="{{isFavorited ? '/assets/images/ktv/star-active.svg' : '/assets/images/ktv/star.svg'}}" mode="aspectFit" />
        <text>{{favoriteSubmitting ? '处理中' : (isFavorited ? '已收藏' : '收藏')}}</text>
      </button>
      <button class="actions__share" hover-class="none" open-type="share">分享</button>
      <button
        wx:if="{{canSwitchPartyStatus}}"
        class="actions__status"
        hover-class="none"
        disabled="{{statusSwitchSubmitting}}"
        bindtap="handleStatusSwitchTap"
      >{{statusSwitchSubmitting ? '处理中' : statusSwitchText}}</button>
      <button wx:if="{{canViewContacts}}" class="actions__primary" hover-class="none" bindtap="handleOpenEntryDetails">报名详情</button>
      <button
        wx:elif="{{canQuitParty}}"
        class="actions__primary actions__primary--danger"
        hover-class="none"
        disabled="{{quitSubmitting}}"
        bindtap="handleQuitPartyTap"
      >{{quitSubmitting ? '处理中' : '退出报名'}}</button>
      <button
        wx:elif="{{canWaitlistParty}}"
        class="actions__primary actions__primary--waitlist"
        hover-class="none"
        disabled="{{waitlistSubmitting}}"
        bindtap="handleWaitlist"
      >{{waitlistSubmitting ? '处理中' : '候补报名'}}</button>
      <button wx:else class="actions__primary" hover-class="none" bindtap="handleJoin">立即报名</button>
    </view>
  </block>
</view>

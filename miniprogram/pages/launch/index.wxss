.launch-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 172rpx;
  background: #fbfcff;
  box-sizing: border-box;
}

.cover-title {
  display: flex;
  gap: 20rpx;
  margin-top: 18rpx;
}

.cover-upload {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 198rpx;
  height: 198rpx;
  flex: 0 0 198rpx;
  flex-direction: column;
  border-radius: 22rpx;
  background: #f2f3fb;
  color: #303342;
  box-sizing: border-box;
}

.cover-upload__plus {
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

.cover-upload__text {
  margin-top: 18rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.title-box {
  position: relative;
  min-width: 0;
  height: 198rpx;
  flex: 1;
  padding: 34rpx 28rpx 24rpx;
  border: 1rpx solid #f0f1f7;
  border-radius: 22rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.title-box__input {
  width: 100%;
  height: 98rpx;
  color: #1f2335;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
}

.title-box__input::placeholder,
.intro-box__textarea::placeholder {
  color: #c2c7d6;
}

.title-box__footer {
  position: absolute;
  right: 28rpx;
  bottom: 22rpx;
  left: 28rpx;
  display: flex;
  justify-content: space-between;
  color: #b5bbca;
  font-size: 23rpx;
  font-weight: 700;
}

.tag-section {
  margin-top: 36rpx;
}

.section-title {
  display: flex;
  align-items: baseline;
  color: #242738;
  font-size: 28rpx;
  font-weight: 900;
}

.section-title__sub {
  margin-left: 8rpx;
  color: #9da4b6;
  font-size: 24rpx;
  font-weight: 800;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 18rpx;
  margin-top: 20rpx;
}

.tag-cloud__item {
  min-width: 88rpx;
  padding: 13rpx 22rpx;
  border-radius: 16rpx;
  background: #f4f1ff;
  box-sizing: border-box;
  color: #755bff;
  font-size: 25rpx;
  font-weight: 900;
  text-align: center;
}

.tag-cloud__item--active {
  background: #ede8ff;
  color: #6242ff;
}

.form-card {
  margin-top: 28rpx;
  overflow: hidden;
  border: 1rpx solid #eef0f7;
  border-radius: 24rpx;
  background: #ffffff;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid #eef0f7;
  box-sizing: border-box;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-row--people {
  min-height: 112rpx;
}

.form-row__label {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #252838;
  font-size: 26rpx;
  font-weight: 900;
}

.form-row__label image {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.78;
}

.form-row__symbol {
  width: 32rpx;
  color: #414656;
  font-size: 30rpx;
  line-height: 1;
  text-align: center;
}

.form-row__value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #a0a6b7;
  font-size: 25rpx;
  font-weight: 800;
}

.form-row__arrow {
  color: #aeb4c4;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 1;
}

.room-segment {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.room-segment__item {
  padding: 10rpx 17rpx;
  border: 2rpx solid #eff1f7;
  border-radius: 999rpx;
  color: #323545;
  font-size: 25rpx;
  font-weight: 900;
}

.room-segment__item--active {
  border-color: #e7e1ff;
  background: #eee9ff;
  color: #684bff;
}

.people-stepper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 18rpx;
  flex: 1;
  color: #a0a6b7;
  font-size: 25rpx;
  font-weight: 800;
}

.people-stepper__group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stepper-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  min-width: 36rpx;
  max-width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
  border: 2rpx solid #e4e7f1;
  border-radius: 50%;
  background: #ffffff;
  box-sizing: border-box;
  color: #a6adbf;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.launch-submit__button::after {
  border: 0;
}

.intro-section {
  margin-top: 34rpx;
}

.intro-box {
  position: relative;
  height: 150rpx;
  margin-top: 18rpx;
  padding: 28rpx 28rpx 34rpx;
  border: 1rpx solid #eef0f7;
  border-radius: 22rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.intro-box__textarea {
  width: 100%;
  height: 78rpx;
  color: #303342;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.45;
}

.intro-box__count {
  position: absolute;
  right: 28rpx;
  bottom: 18rpx;
  color: #b5bbca;
  font-size: 23rpx;
  font-weight: 700;
}

.launch-submit {
  position: fixed;
  right: 28rpx;
  bottom: calc(26rpx + env(safe-area-inset-bottom));
  left: 28rpx;
}

.launch-submit__button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #8d5cff 0%, #4d30ff 100%);
  box-shadow: 0 14rpx 28rpx rgba(96, 64, 255, 0.2);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

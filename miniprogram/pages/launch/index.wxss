.launch-page {
  padding: 32rpx 24rpx;
}

.launch-card {
  padding: 44rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f2efff 100%);
  box-shadow: var(--shadow-soft);
}

.launch-card__title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
}

.launch-card__desc {
  display: block;
  margin: 16rpx 0 32rpx;
  color: var(--text-secondary);
}

.launch-card__primary,
.launch-card__secondary {
  margin-top: 16rpx;
  border-radius: 18rpx;
  font-weight: 900;
}

.launch-card__primary {
  background: linear-gradient(135deg, #8e66ff, #5237f2);
  color: #ffffff;
}

.launch-card__secondary {
  background: #ffffff;
  color: var(--brand);
}

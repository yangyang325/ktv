<view class="page launch-page">
  <view class="cover-title">
    <view class="cover-upload" bindtap="handleCoverTap">
      <image
        wx:if="{{coverPreviewPath}}"
        class="cover-upload__image"
        src="{{coverPreviewPath}}"
        mode="aspectFill"
      />
      <view wx:else class="cover-upload__placeholder">
        <text class="cover-upload__plus">＋</text>
        <text class="cover-upload__text">上传封面</text>
      </view>
      <view wx:if="{{uploadingCover}}" class="cover-upload__mask">
        <text>上传中</text>
      </view>
      <text wx:if="{{coverImage && !uploadingCover}}" class="cover-upload__change">更换</text>
    </view>

    <view class="title-box">
      <textarea
        class="title-box__input"
        placeholder="给活动起个清晰标题吧"
        maxlength="30"
        value="{{form.title}}"
        data-field="title"
        bindinput="handleFieldChange"
      ></textarea>
      <view class="title-box__footer">
        <text>请输入1字</text>
        <text>{{titleLength}}/30</text>
      </view>
    </view>
  </view>

  <view class="tag-section">
    <view class="section-title">
      <text>选择活动属性</text>
      <text class="section-title__sub">（可多选）</text>
    </view>
    <view class="tag-cloud">
      <text
        wx:for="{{tags}}"
        wx:key="name"
        class="tag-cloud__item {{item.selected ? 'tag-cloud__item--active' : ''}}"
        data-tag="{{item.name}}"
        hover-class="tag-cloud__item--pressed"
        bindtap="handleTagTap"
      >{{item.name}}</text>
    </view>
  </view>

  <view class="form-card">
    <view class="form-row form-row--time">
      <view class="form-row__label">
        <image src="/assets/images/ktv/clock.svg" mode="aspectFit" />
        <text>活动时间</text>
      </view>
      <view class="time-picker-group">
        <picker mode="date" value="{{form.date}}" start="{{todayDate}}" bindchange="handleDateChange">
          <view class="time-picker__chip {{form.date ? '' : 'time-picker__chip--placeholder'}}">
            {{form.date || '选择日期'}}
          </view>
        </picker>
        <picker mode="time" value="{{form.startTime}}" bindchange="handleStartTimeChange">
          <view class="time-picker__chip {{form.startTime ? '' : 'time-picker__chip--placeholder'}}">
            {{form.startTime || '选择时间'}}
          </view>
        </picker>
        <text class="form-row__arrow">›</text>
      </view>
    </view>

    <view class="form-row form-row--duration">
      <view class="form-row__label">
        <text class="form-row__symbol">⌁</text>
        <text>欢唱时长</text>
      </view>
      <view class="duration-field">
        <input
          type="digit"
          class="duration-field__input"
          value="{{form.durationHour}}"
          data-field="durationHour"
          bindinput="handleFieldChange"
          placeholder="填写小时数"
        />
        <text class="duration-field__unit">小时</text>
      </view>
    </view>

    <view class="form-row" bindtap="handleVenueLocationTap">
      <view class="form-row__label">
        <image src="/assets/images/ktv/location.svg" mode="aspectFit" />
        <text>活动地点</text>
      </view>
      <view class="form-row__value {{form.venueId ? '' : 'form-row__value--placeholder'}}">
        <text class="form-row__value-text">{{form.venueText}}</text>
        <text class="form-row__arrow">›</text>
      </view>
    </view>

    <view class="form-row">
      <view class="form-row__label">
        <text class="form-row__symbol">◉</text>
        <text>费用说明</text>
      </view>
      <view class="room-segment">
        <text
          wx:for="{{roomTypes}}"
          wx:key="value"
          class="room-segment__item {{form.roomType === item.value ? 'room-segment__item--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleRoomTypeTap"
        >{{item.label}}</text>
      </view>
    </view>

    <view class="form-row form-row--fee">
      <view class="form-row__label">
        <image src="/assets/images/ktv/yen.svg" mode="aspectFit" />
        <text>包厢费用参考</text>
      </view>
      <view class="fee-field">
        <view class="fee-field__main">
          <input
            type="digit"
            class="fee-field__input"
            value="{{form.roomFee}}"
            data-field="roomFee"
            bindinput="handleFieldChange"
            placeholder="填写金额"
          />
          <text class="fee-field__unit">元</text>
        </view>
        <text class="fee-field__hint">仅作线下AA参考，小程序不收款</text>
      </view>
    </view>

    <view class="form-row form-row--people">
      <view class="form-row__label">
        <image src="/assets/images/ktv/users.svg" mode="aspectFit" />
        <text>预计人数</text>
      </view>
      <view class="people-stepper">
        <view class="people-stepper__group">
          <text class="people-stepper__label">最少</text>
          <view class="stepper-button" data-field="minPeople" data-step="{{-1}}" hover-class="stepper-button--pressed" bindtap="handlePeopleStep">-</view>
          <text class="people-stepper__value">{{form.minPeople}}人</text>
          <view class="stepper-button" data-field="minPeople" data-step="{{1}}" hover-class="stepper-button--pressed" bindtap="handlePeopleStep">+</view>
        </view>
        <view class="people-stepper__group">
          <text class="people-stepper__label">最多</text>
          <view class="stepper-button" data-field="maxPeople" data-step="{{-1}}" hover-class="stepper-button--pressed" bindtap="handlePeopleStep">-</view>
          <text class="people-stepper__value">{{form.maxPeople}}人</text>
          <view class="stepper-button" data-field="maxPeople" data-step="{{1}}" hover-class="stepper-button--pressed" bindtap="handlePeopleStep">+</view>
        </view>
      </view>
    </view>

    <view class="form-row">
      <view class="form-row__label">
        <text class="form-row__symbol">⚙</text>
        <text>曲风偏好</text>
      </view>
      <picker
        class="preference-picker"
        mode="selector"
        range="{{preferenceOptions}}"
        value="{{preferenceIndex}}"
        bindchange="handlePreferenceChange"
      >
        <view class="form-row__value preference-picker__value">
          <text class="form-row__value-text">{{form.preference}}</text>
          <text class="form-row__arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <view class="intro-section">
    <view class="section-title">
      <text>活动介绍</text>
      <text class="section-title__sub">（选填）</text>
    </view>
    <view class="intro-box">
      <textarea
        class="intro-box__textarea"
        placeholder="说明本次活动的曲风、时间安排和线下AA参考等..."
        maxlength="200"
        value="{{form.notes}}"
        data-field="notes"
        bindinput="handleFieldChange"
      ></textarea>
      <text class="intro-box__count">{{notesLength}}/200</text>
    </view>
  </view>

  <view class="launch-submit">
    <button
      class="launch-submit__button"
      loading="{{publishing}}"
      disabled="{{publishing}}"
      bindtap="handleSubmit"
    >{{publishing ? '发布中...' : '发布活动'}}</button>
  </view>
</view>

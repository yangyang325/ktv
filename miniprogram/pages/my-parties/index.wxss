.my-page {
  padding: 30rpx 22rpx 36rpx;
}

.my-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
}

.my-header__title {
  color: var(--text-primary);
  font-size: 36rpx;
  font-weight: 900;
}

.tabs {
  margin-bottom: 22rpx;
  white-space: nowrap;
}

.tabs__item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  padding: 12rpx 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: var(--shadow-card);
}

.tabs__item--active {
  background: var(--brand-soft);
  color: var(--brand);
}

.list {
  display: block;
}

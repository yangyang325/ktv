.discover-page {
  padding: 16rpx 16rpx 178rpx;
  background: #f8f9ff;
}

.discover-panel {
  z-index: 5;
  padding-bottom: 12rpx;
  background: #f8f9ff;
}

.city-row {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  margin-bottom: 10rpx;
  color: #24283b;
  font-size: 24rpx;
  font-weight: 700;
}

.city-row image {
  display: block;
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.city-row__arrow {
  display: block;
  width: 10rpx;
  height: 10rpx;
  margin-left: 10rpx;
  margin-top: -4rpx;
  box-sizing: border-box;
  border-right: 3rpx solid #796bff;
  border-bottom: 3rpx solid #796bff;
  transform: rotate(45deg);
}

.search {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding-left: 22rpx;
  overflow: hidden;
  border: 2rpx solid #dcd8ff;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(93, 81, 188, 0.08);
}

.search__icon {
  color: #9aa0b8;
  font-size: 32rpx;
  line-height: 1;
}

.search__input {
  min-width: 0;
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  color: #1d2032;
  font-size: 24rpx;
}

.search__button {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  width: 104rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8f72ff 0%, #5f45ee 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.section-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 54rpx;
  margin: 22rpx 0 14rpx;
  overflow: hidden;
}

.section-tabs {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.section-tabs__item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  margin-right: 30rpx;
  color: #232638;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.section-tabs__item text {
  line-height: 1;
}

.section-tabs__item--active {
  color: #171a2c;
}

.section-tabs__item--active::after {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 2rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #6b4cff;
  content: "";
}

.discover-list {
  display: flex;
  flex-direction: column;
}

.party-card {
  display: flex;
  min-height: 196rpx;
  margin-bottom: 18rpx;
  padding: 12rpx 12rpx 12rpx 10rpx;
  box-sizing: border-box;
  border: 1rpx solid #eef1f7;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(41, 45, 84, 0.06);
}

.party-card__cover {
  position: relative;
  width: 220rpx;
  height: 172rpx;
  flex: 0 0 220rpx;
  overflow: hidden;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #131629;
}

.party-card__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.party-card__cover::after {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(10, 8, 28, 0.12), rgba(10, 8, 28, 0.24)),
    linear-gradient(45deg, rgba(118, 75, 255, 0.16), rgba(255, 72, 148, 0));
  content: "";
}

.party-card__status {
  position: absolute;
  z-index: 2;
  top: 10rpx;
  left: 10rpx;
  display: inline-flex;
  align-items: center;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 800;
}

.party-card__status--signup {
  background: #16c878;
}

.party-card__status--active {
  background: #2497ff;
}

.party-card__status--full {
  background: #ff982b;
}

.party-card__status--finished {
  background: rgba(25, 27, 42, 0.72);
}

.party-card__ktv {
  position: absolute;
  z-index: 2;
  left: 28rpx;
  bottom: 36rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.party-card__content {
  min-width: 0;
  flex: 1;
  padding: 0;
}

.party-card__headline {
  display: flex;
  align-items: center;
}

.party-card__title {
  display: block;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #1e2234;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.party-card__favorite {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  margin-left: 10rpx;
}

.party-card__tags {
  display: flex;
  flex-wrap: nowrap;
  height: 32rpx;
  margin-top: 5rpx;
  overflow: hidden;
}

.party-card__tag {
  display: inline-flex;
  align-items: center;
  height: 30rpx;
  margin-right: 8rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #f1efff;
  color: #6048ff;
  font-size: 18rpx;
  font-weight: 700;
  white-space: nowrap;
}

.party-card__meta {
  display: flex;
  align-items: center;
  gap: 7rpx;
  margin-top: 5rpx;
  color: #8b91a6;
  font-size: 20rpx;
  line-height: 27rpx;
}

.party-card__meta--venue {
  align-items: flex-start;
}

.party-card__meta-icon {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.58;
}

.party-card__meta--venue .party-card__meta-icon {
  margin-top: 2rpx;
}

.party-card__venue {
  display: -webkit-box;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  line-height: 27rpx;
  text-overflow: ellipsis;
  white-space: normal;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.party-card__distance {
  flex: 0 0 auto;
  color: #a6abbb;
  font-size: 20rpx;
  line-height: 27rpx;
}

.party-card__footer {
  display: flex;
  align-items: center;
  margin-top: 7rpx;
}

.party-card__avatars {
  display: flex;
  flex: 0 0 auto;
  margin-right: 12rpx;
}

.party-card__avatar {
  width: 28rpx;
  height: 28rpx;
  margin-right: -7rpx;
  box-sizing: border-box;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  background: #eef1ff;
}

.party-card__progress {
  color: #7d8296;
  font-size: 21rpx;
  font-weight: 700;
}

.party-card__price {
  margin-left: auto;
  color: #ff443f;
  font-size: 27rpx;
  font-weight: 900;
}

.party-card__meta-icon {
  flex: 0 0 auto;
}

@media (max-width: 360px) {
  .discover-page {
    padding-left: 14rpx;
    padding-right: 14rpx;
  }

  .party-card__cover {
    width: 202rpx;
    flex-basis: 202rpx;
  }

}

.profile-edit-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 7%, rgba(127, 118, 255, 0.12) 0, rgba(127, 118, 255, 0) 28%),
    linear-gradient(180deg, #fbfcff 0%, #f4f6ff 62%, #ffffff 100%);
  box-sizing: border-box;
}

.edit-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.edit-content {
  padding: 42rpx 28rpx 44rpx;
  box-sizing: border-box;
}

.edit-card {
  overflow: hidden;
  margin-bottom: 22rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 42rpx rgba(42, 48, 100, 0.07);
  box-sizing: border-box;
}

.edit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  box-sizing: border-box;
}

.edit-row--avatar {
  min-height: 176rpx;
}

.edit-row + .edit-row,
picker + picker .edit-row,
picker + .edit-row,
.edit-row + picker .edit-row,
.avatar-options + .edit-row {
  border-top: 1rpx solid #edf0f8;
}

.edit-row__label {
  flex: 0 0 auto;
  color: #111525;
  font-size: 30rpx;
  font-weight: 900;
}

.edit-row__value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  flex: 1;
  gap: 20rpx;
  margin-left: 24rpx;
}

.edit-row__text {
  overflow: hidden;
  max-width: 380rpx;
  color: #7e8498;
  font-size: 29rpx;
  font-weight: 700;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-row__input {
  width: 320rpx;
  height: 70rpx;
  color: #7e8498;
  font-size: 29rpx;
  font-weight: 700;
  text-align: right;
}

.edit-row__input--intro {
  width: 400rpx;
}

.edit-row__placeholder {
  color: #a9afbf;
  font-weight: 700;
}

.edit-row__arrow {
  color: #a9afbf;
  font-size: 54rpx;
  font-weight: 400;
  line-height: 1;
}

.edit-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #f0f2fb;
}

.avatar-options {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 18rpx;
  padding: 0 0 28rpx 154rpx;
  box-sizing: border-box;
}

.avatar-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border: 3rpx solid transparent;
  border-radius: 50%;
  background: #f4f6ff;
  box-sizing: border-box;
}

.avatar-option--active {
  border-color: #6048ff;
  box-shadow: 0 8rpx 18rpx rgba(96, 72, 255, 0.18);
}

.avatar-option__image {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin: 34rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1;
}

.save-button {
  background: linear-gradient(135deg, #875cff 0%, #573ef5 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 34rpx rgba(98, 66, 255, 0.24);
}

.save-button[disabled] {
  background: linear-gradient(135deg, #875cff 0%, #573ef5 100%);
  color: #ffffff !important;
  opacity: 1;
}

.save-button::after {
  border: 0;
}

page {
  background: #f8f9ff;
}

.favorites-page {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  padding: 24rpx 24rpx 184rpx;
  background:
    radial-gradient(circle at 48% 57%, rgba(123, 96, 255, 0.08) 0, rgba(123, 96, 255, 0) 34%),
    linear-gradient(180deg, #ffffff 0%, #fbfbff 31%, #f7f8ff 100%);
  box-sizing: border-box;
}

.favorites-hero {
  position: relative;
  z-index: 1;
  min-height: 262rpx;
  margin-top: 8rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #efeaff;
  box-shadow: 0 18rpx 42rpx rgba(114, 93, 201, 0.13);
}

.favorites-hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.favorites-hero__content {
  position: relative;
  z-index: 2;
  padding: 46rpx 34rpx 34rpx;
  box-sizing: border-box;
}

.favorites-hero__title {
  display: block;
  max-width: 420rpx;
  color: #17259b;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.favorites-stats {
  display: flex;
  flex-wrap: nowrap;
  gap: 12rpx;
  margin-top: 36rpx;
}

.favorites-stats__item {
  display: flex;
  align-items: center;
  width: 214rpx;
  min-width: 0;
  height: 112rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 24rpx rgba(68, 58, 145, 0.08);
  box-sizing: border-box;
  white-space: nowrap;
}

.favorites-stats__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.favorites-stats__icon--purple {
  background: linear-gradient(145deg, #8263ff 0%, #5c42eb 100%);
}

.favorites-stats__copy {
  display: flex;
  align-items: baseline;
  min-width: 0;
  margin-left: 10rpx;
  white-space: nowrap;
}

.favorites-stats__label {
  color: #1c2033;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.12;
  white-space: nowrap;
}

.favorites-stats__value {
  margin-left: 12rpx;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}

.favorites-stats__value--purple {
  color: #6650ff;
}

.favorites-list {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
}

.favorites-empty {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
  min-height: 660rpx;
  padding-top: 116rpx;
  text-align: center;
  box-sizing: border-box;
}

.favorites-empty__title {
  color: #080a12;
  font-size: 35rpx;
  font-weight: 900;
  line-height: 1.2;
}

.favorites-empty__desc {
  width: 620rpx;
  margin-top: 26rpx;
  color: #6e7387;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.55;
}

.favorites-empty__image {
  width: 388rpx;
  height: 344rpx;
  margin-top: 52rpx;
}

.page-tabbar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(226, 229, 238, 0.88);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -10rpx 34rpx rgba(40, 45, 90, 0.08);
  box-sizing: content-box;
}

.page-tabbar__item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #848ba0;
  font-size: 22rpx;
  font-weight: 600;
}

.page-tabbar__item--active {
  color: #6048ff;
  font-weight: 900;
}

.page-tabbar__icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.page-tabbar__icon {
  width: 48rpx;
  height: 48rpx;
}

.page-tabbar__badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  background: #ff1d2d;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}

.page-tabbar__label {
  margin-top: 6rpx;
  line-height: 1;
}

<view class="page favorites-page">
  <view class="favorites-hero">
    <image
      class="favorites-hero__bg"
      src="https://wechatapppro-1252524126.cdn.xiaoeknow.com/appbtajnbm33436/image/b_u_616d1cc7eabb6_eanzXeE6/5ufdjbmpkznptd.png"
      mode="aspectFill"
    />
    <view class="favorites-hero__content">
      <text class="favorites-hero__title">管理你的收藏内容</text>
      <view class="favorites-stats">
        <view class="favorites-stats__item" wx:for="{{stats}}" wx:key="key">
          <view class="favorites-stats__icon favorites-stats__icon--{{item.tone}}">
            <image class="favorites-stats__icon-image" src="{{item.icon}}" mode="aspectFit" />
          </view>
          <view class="favorites-stats__copy">
            <text class="favorites-stats__label">{{item.label}}</text>
            <text class="favorites-stats__value favorites-stats__value--{{item.tone}}">{{item.value}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="favorites-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="favorites-tabs__item {{item.active ? 'favorites-tabs__item--active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="handleTabTap"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <block wx:if="{{currentTab === 'activities'}}">
    <view wx:if="{{showFavoriteParties}}" class="favorites-list">
      <party-card wx:for="{{favoriteParties}}" wx:key="partyId" party="{{item}}" />
    </view>

    <view wx:else class="favorites-empty">
      <text class="favorites-empty__title">这里还没有收藏活动</text>
      <text class="favorites-empty__desc">去发现页逛逛，收藏你感兴趣的活动。</text>
      <image
        class="favorites-empty__image"
        src="https://wechatapppro-1252524126.cdn.xiaoeknow.com/appbtajnbm33436/image/b_u_616d1cc7eabb6_eanzXeE6/q4ed2ampkznpsu.png"
        mode="aspectFit"
      />
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{showFollowedUsers}}" class="favorite-users">
      <view
        wx:for="{{followedUsers}}"
        wx:key="userId"
        class="favorite-user-card"
        data-user-id="{{item.userId}}"
        bindtap="handleUserTap"
      >
        <image class="favorite-user-card__avatar" src="{{item.avatarUrl || defaultAvatarUrl}}" mode="aspectFill" />
        <view class="favorite-user-card__body">
          <text class="favorite-user-card__name">{{item.nickname}}</text>
          <text class="favorite-user-card__intro">{{item.intro || 'K歌爱好者'}}</text>
          <view wx:if="{{item.tags && item.tags.length}}" class="favorite-user-card__tags">
            <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="favorite-user-card__tag">{{tag}}</text>
          </view>
        </view>
        <text class="favorite-user-card__arrow">›</text>
      </view>
    </view>

    <view wx:else class="favorites-empty">
      <text class="favorites-empty__title">这里还没有关注用户</text>
      <text class="favorites-empty__desc">去活动详情页关注你感兴趣的发起者。</text>
      <image
        class="favorites-empty__image"
        src="https://wechatapppro-1252524126.cdn.xiaoeknow.com/appbtajnbm33436/image/b_u_616d1cc7eabb6_eanzXeE6/q4ed2ampkznpsu.png"
        mode="aspectFit"
      />
    </view>
  </block>

  <view class="page-tabbar">
    <view
      wx:for="{{bottomNav}}"
      wx:key="key"
      class="page-tabbar__item {{item.active ? 'page-tabbar__item--active' : ''}}"
      data-path="{{item.path}}"
      bindtap="handleBottomNavTap"
    >
      <view class="page-tabbar__icon-wrap">
        <image class="page-tabbar__icon" src="{{item.active ? item.activeIcon : item.icon}}" mode="aspectFit" />
        <text wx:if="{{item.badge}}" class="page-tabbar__badge">{{item.badge}}</text>
      </view>
      <text class="page-tabbar__label">{{item.label}}</text>
    </view>
  </view>
</view>

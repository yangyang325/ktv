.profile-tags-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 7%, rgba(127, 118, 255, 0.12) 0, rgba(127, 118, 255, 0) 28%),
    linear-gradient(180deg, #fbfcff 0%, #f4f6ff 62%, #ffffff 100%);
  box-sizing: border-box;
}

.tag-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.tag-content {
  padding: 34rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.tag-card {
  padding: 32rpx 28rpx 34rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 42rpx rgba(42, 48, 100, 0.07);
  box-sizing: border-box;
}

.tag-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.tag-card__title {
  color: #171b2d;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.1;
}

.tag-card__count {
  color: #704fff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
}

.tag-category + .tag-category {
  margin-top: 34rpx;
}

.tag-category__title {
  display: block;
  margin-bottom: 18rpx;
  color: #4b5269;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
}

.tag-option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx 20rpx;
  overflow: hidden;
}

.tag-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  min-height: 68rpx;
  overflow: hidden;
  margin: 0;
  padding: 10rpx 18rpx;
  border: 2rpx solid #edf0f8;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4b5269;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  box-sizing: border-box;
}

.tag-option__text {
  display: block;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-option::after {
  border: 0;
}

.tag-option--purple {
  background: #ffffff;
  color: #4b5269;
}

.tag-option--blue {
  background: #ffffff;
  color: #4b5269;
}

.tag-option--green {
  background: #ffffff;
  color: #4b5269;
}

.tag-option--orange {
  background: #ffffff;
  color: #4b5269;
}

.tag-option--pink {
  background: #ffffff;
  color: #4b5269;
}

.tag-option--active {
  border-color: #704fff;
  background: #704fff;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(112, 79, 255, 0.16);
}

.tag-save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin: 34rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #875cff 0%, #573ef5 100%);
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 18rpx 34rpx rgba(98, 66, 255, 0.24);
}

.tag-save-button[disabled] {
  background: linear-gradient(135deg, #875cff 0%, #573ef5 100%);
  color: #ffffff !important;
  opacity: 1;
}

.tag-save-button::after {
  border: 0;
}

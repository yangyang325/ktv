  --surface-strong: #f1efff;
  --brand: #6b4cff;
  --brand-deep: #4b32df;
  --brand-soft: #ebe7ff;
  --accent-blue: #43a6ff;
  --accent-pink: #ff6f9f;
  --accent-green: #26c779;
  --accent-orange: #ff9f36;
  --text-primary: #181b2f;
  --text-secondary: #737994;
  --text-muted: #a3a8bc;

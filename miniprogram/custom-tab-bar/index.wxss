.tabbar {
  position: fixed;
  z-index: 999;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 0 0 env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #ffffff;
}

.tabbar__panel {
  display: flex;
  align-items: center;
  justify-content: space-around;
  min-height: 128rpx;
  padding: 10rpx 0 12rpx;
  background: #ffffff;
  box-shadow: 0 -8rpx 28rpx rgba(37, 45, 92, 0.06);
  box-sizing: border-box;
}

.tabbar__item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 25%;
  min-height: 106rpx;
  flex-direction: column;
  color: #848ba0;
}

.tabbar__icon-wrap {
  position: relative;
  width: 76rpx;
  height: 64rpx;
}

.tabbar__icon {
  display: block;
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto;
}

.tabbar__text {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.tabbar__item--active {
  color: #6048ff;
}

.tabbar__badge {
  position: absolute;
  top: -2rpx;
  right: 4rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  background: #ff2b30;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 23rpx;
  text-align: center;
  transform: translateY(1rpx);
}

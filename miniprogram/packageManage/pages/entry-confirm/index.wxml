<view class="page entry-confirm-page">
  <block wx:if="{{detail}}">
    <view class="confirm-party-card">
      <image class="confirm-party-card__cover" src="{{detail.party.coverImage}}" mode="aspectFill" />
      <view class="confirm-party-card__body">
        <text class="confirm-party-card__title">{{displayTitle}}</text>
        <view class="confirm-party-card__tags">
          <text class="confirm-party-card__tag" wx:for="{{displayTags}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="confirm-party-card__meta">
          <view class="confirm-meta-row confirm-meta-row--time">
            <image class="confirm-meta-row__icon" src="/assets/images/ktv/clock.svg" mode="aspectFit" />
            <text class="confirm-meta-row__text">{{detail.party.timeSummary}}（预计{{durationHourText}}小时）</text>
          </view>
          <view class="confirm-meta-row">
            <image class="confirm-meta-row__icon" src="/assets/images/ktv/location.svg" mode="aspectFit" />
            <text class="confirm-meta-row__text">{{detail.party.venueSummary}}</text>
          </view>
          <view class="confirm-meta-row">
            <image class="confirm-meta-row__icon" src="/assets/images/ktv/users.svg" mode="aspectFit" />
            <view class="confirm-meta-row__text confirm-capacity">
              <text>已报名 </text>
              <text class="confirm-capacity__current {{remainingCount === 0 ? 'confirm-capacity__current--full' : ''}}">{{capacityConfirmedCount}}</text>
              <text class="confirm-capacity__separator {{remainingCount === 0 ? 'confirm-capacity__separator--full' : ''}}">/</text>
              <text class="confirm-capacity__total {{remainingCount === 0 ? 'confirm-capacity__total--full' : ''}}">{{capacityMaxCount}}</text>
              <text>人 · {{distanceText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="confirm-fee-card">
      <view class="confirm-card-title">
        <view class="confirm-card-title__icon confirm-card-title__icon--fee">￥</view>
        <text>AA参考</text>
      </view>
      <text class="confirm-fee-card__price">线下AA参考  {{detail.party.priceText}}</text>
    </view>

    <view class="confirm-section-card confirm-section-card--quota">
      <view class="confirm-card-title">
        <image class="confirm-card-title__image" src="/assets/images/ktv/confirm-users.svg" mode="aspectFit" />
        <text>名额与备注</text>
      </view>
      <view class="confirm-section-card__side confirm-capacity">
        <text class="confirm-capacity__current {{remainingCount === 0 ? 'confirm-capacity__current--full' : ''}}">{{capacityConfirmedCount}}</text>
        <text class="confirm-capacity__separator {{remainingCount === 0 ? 'confirm-capacity__separator--full' : ''}}">/</text>
        <text class="confirm-capacity__total {{remainingCount === 0 ? 'confirm-capacity__total--full' : ''}}">{{capacityMaxCount}}</text>
        <text>人</text>
      </view>
      <text class="confirm-section-card__desc">剩余{{remainingCount}}个活动名额，按实际到场情况线下确认</text>
    </view>

    <view class="confirm-section-card confirm-section-card--contact">
      <view class="confirm-card-title">
        <image class="confirm-card-title__image" src="/assets/images/ktv/confirm-phone.svg" mode="aspectFit" />
        <text>活动通知</text>
      </view>
      <text class="confirm-section-card__desc">报名后可在小程序消息中查看活动通知</text>
      <view class="confirm-privacy">
        <image class="confirm-privacy__shield" src="/assets/images/ktv/confirm-shield.svg" mode="aspectFit" />
        <text>小程序不收款，仅记录必要活动信息</text>
      </view>
    </view>

    <view class="confirm-section-card confirm-section-card--entry-contact">
      <view class="confirm-card-title">
        <image class="confirm-card-title__image" src="/assets/images/ktv/confirm-shield.svg" mode="aspectFit" />
        <text>入群联系信息</text>
      </view>
      <text class="confirm-section-card__desc confirm-section-card__desc--entry-contact">仅用于本次K歌活动建群、集合和包厢通知，只有发起人可见</text>
      <view class="confirm-contact-form">
        <view class="confirm-contact-row">
          <text class="confirm-contact-row__label">方式</text>
          <picker
            class="confirm-contact-row__picker-wrap"
            mode="selector"
            range="{{contactMethodOptions}}"
            range-key="label"
            value="{{contactMethodIndex}}"
            bindchange="handleContactMethodChange"
          >
            <view class="confirm-contact-row__picker">{{contactMethodLabel}}</view>
          </picker>
        </view>
        <view class="confirm-contact-row">
          <text class="confirm-contact-row__label">信息</text>
          <input
            class="confirm-contact-row__input"
            value="{{contactForm.value}}"
            placeholder="{{contactValuePlaceholder}}"
            placeholder-class="confirm-contact-row__placeholder"
            maxlength="40"
            bindinput="handleContactValueInput"
          />
        </view>
        <view class="confirm-contact-row">
          <text class="confirm-contact-row__label">到达</text>
          <picker
            class="confirm-contact-row__picker-wrap"
            mode="time"
            value="{{contactForm.arrivalTime}}"
            bindchange="handleArrivalTimeChange"
          >
            <view class="confirm-contact-row__picker {{contactForm.arrivalTime ? '' : 'confirm-contact-row__picker--placeholder'}}">{{contactForm.arrivalTime ? contactForm.arrivalTime : '选择预计到达时间'}}</view>
          </picker>
        </view>
        <view class="confirm-contact-note">
          <textarea
            class="confirm-contact-note__input"
            value="{{contactForm.note}}"
            placeholder="可补充到店说明，如稍晚到、等发起人通知"
            placeholder-class="confirm-contact-row__placeholder"
            maxlength="80"
            auto-height="{{true}}"
            bindinput="handleContactNoteInput"
          />
        </view>
      </view>
    </view>

    <view class="confirm-agreement" hover-class="none" bindtap="toggleAgreement">
      <view class="confirm-agreement__check {{agreementChecked ? 'confirm-agreement__check--active' : ''}}"></view>
      <view class="confirm-agreement__content">
        <text class="confirm-agreement__text">我已阅读并同意</text>
        <text class="confirm-agreement__link" catchtap="openAgreement">《K歌活动参与须知》</text>
      </view>
    </view>
    <view class="confirm-entry-notice">
      <text>活动开始前成员名单可能调整，请以发起者最终联系通知为准</text>
    </view>

    <view class="confirm-bottom-card">
      <view class="confirm-total">
        <text class="confirm-total__label">参考金额</text>
        <view class="confirm-total__amount">
          <text class="confirm-total__symbol">￥</text>
          <text class="confirm-total__number">{{payAmount}}</text>
        </view>
      </view>
      <button
        class="confirm-submit"
        hover-class="none"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="handleConfirm"
      >{{submitting ? '提交中' : (entryMode === 'waitlist' ? '确认候补' : '确认报名')}}</button>
    </view>
  </block>
</view>

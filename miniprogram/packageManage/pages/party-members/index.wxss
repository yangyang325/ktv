.members-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #f4f5fa;
  box-sizing: border-box;
}

.members-summary,
.entry-list-card,
.member-detail-card {
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(36, 38, 64, 0.06);
  box-sizing: border-box;
}

.members-summary {
  position: relative;
  display: flex;
  align-items: center;
  gap: 26rpx;
  min-height: 216rpx;
  padding: 24rpx;
}

.members-summary__cover {
  width: 210rpx;
  height: 168rpx;
  flex: 0 0 210rpx;
  border-radius: 12rpx;
  background: #dfe3ef;
}

.members-summary__body {
  min-width: 0;
  flex: 1;
}

.members-summary__title {
  display: block;
  overflow: hidden;
  color: #232738;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.members-summary__line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
  color: #313648;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
}

.members-summary__line image {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
}

.members-summary__line text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.members-summary__line--count {
  font-size: 34rpx;
  font-weight: 900;
}

.members-summary__count-current {
  color: #6048ff;
}

.entry-list-card,
.member-detail-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
}

.entry-list-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-list-card__title,
.member-detail-card__title {
  color: #222637;
  font-size: 32rpx;
  font-weight: 900;
}

.entry-list-card__title {
  min-width: 0;
  flex: 1;
}

.entry-list-card__sort {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  color: #747b8f;
  font-size: 25rpx;
  font-weight: 700;
}

.member-entry-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 22rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid #edf0f7;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(36, 38, 64, 0.05);
  box-sizing: border-box;
}

.member-entry-card__profile {
  display: flex;
  min-width: 0;
  flex: 0 0 220rpx;
  gap: 18rpx;
}

.member-entry-card__avatar,
.member-detail-card__avatar {
  flex: 0 0 auto;
  border-radius: 50%;
  background: #eef1f7;
}

.member-entry-card__avatar {
  width: 84rpx;
  height: 84rpx;
}

.member-entry-card__meta {
  min-width: 0;
  flex: 1;
}

.member-entry-card__name-row,
.member-detail-card__name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.member-entry-card__name,
.member-detail-card__name {
  flex: 1 1 120rpx;
  min-width: 0;
  overflow: hidden;
  color: #202436;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-entry-card__name {
  font-size: 30rpx;
}

.member-entry-card__label {
  display: block;
  margin-top: 14rpx;
  color: #8a91a6;
  font-size: 24rpx;
  font-weight: 700;
}

.member-entry-card__sub {
  display: block;
  overflow: hidden;
  margin-top: 5rpx;
  color: #7c8498;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-entry-card__divider {
  width: 1rpx;
  flex: 0 0 1rpx;
  background: #edf0f7;
}

.member-entry-card__detail {
  width: 328rpx;
  flex: 0 0 328rpx;
}

.member-entry-card__detail-row {
  position: relative;
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 20rpx;
}

.member-entry-card__detail-row:first-child {
  margin-top: 0;
}

.member-entry-card__detail-label,
.member-info-row__label {
  color: #8a91a6;
  font-size: 24rpx;
  font-weight: 700;
}

.member-entry-card__detail-value,
.member-info-row__value {
  min-width: 0;
  color: #202436;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
  word-break: break-all;
}

.member-copy-button {
  position: absolute;
  right: 0;
  top: -2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  background: transparent;
  box-sizing: border-box;
  color: #6048ff;
}

.member-copy-button__icon {
  position: relative;
  display: block;
  width: 24rpx;
  height: 24rpx;
}

.member-copy-button__icon::before,
.member-copy-button__icon::after {
  content: "";
  position: absolute;
  width: 14rpx;
  height: 16rpx;
  border: 3rpx solid #6048ff;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.member-copy-button__icon::before {
  left: 3rpx;
  top: 6rpx;
  opacity: 0.5;
}

.member-copy-button__icon::after {
  left: 7rpx;
  top: 2rpx;
  background: #ffffff;
}

.entry-list-card__empty {
  display: block;
  padding: 80rpx 0;
  color: #8a91a6;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.member-detail-card {
  padding: 34rpx 28rpx 24rpx;
}

.member-detail-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.member-detail-card__title {
  display: block;
}

.member-detail-card__back {
  flex: 0 0 auto;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f1efff;
  color: #6048ff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.member-detail-card__profile {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 36rpx;
}

.member-detail-card__avatar {
  width: 96rpx;
  height: 96rpx;
}

.member-detail-card__profile-body {
  min-width: 0;
  flex: 1;
}

.member-detail-card__name {
  font-size: 34rpx;
}

.member-detail-card__status {
  display: flex;
  width: 154rpx;
  height: 56rpx;
  flex: 0 0 154rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 2rpx solid currentColor;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.member-detail-card__status--pending {
  background: #ffffff;
  color: #6048ff;
}

.member-detail-card__status--confirmed {
  border-color: #9fe7bd;
  background: #eefbf4;
  color: #18a861;
}

.member-detail-card__status-arrow {
  width: 0;
  height: 0;
  border-top: 10rpx solid currentColor;
  border-right: 8rpx solid transparent;
  border-left: 8rpx solid transparent;
}

.member-info-list {
  margin-top: 30rpx;
}

.member-info-row {
  position: relative;
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  gap: 18rpx;
  min-height: 80rpx;
  align-items: center;
  border-top: 1rpx dashed #e4e7ef;
}

.member-info-row:first-child {
  padding-right: 56rpx;
}

.member-copy-button--detail {
  top: 18rpx;
}

.member-detail-card__hint {
  display: block;
  margin-top: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f7;
  color: #8a91a6;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

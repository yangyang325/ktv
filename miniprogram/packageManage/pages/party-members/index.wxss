.manage-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f7fb;
  box-sizing: border-box;
}

.manage-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(36, 38, 64, 0.05);
  box-sizing: border-box;
}

.manage-card--summary {
  background: linear-gradient(135deg, #f5f2ff 0%, #ffffff 100%);
}

.manage-card__title {
  display: block;
  color: #252938;
  font-size: 30rpx;
  font-weight: 900;
}

.manage-card__desc {
  display: block;
  margin-top: 12rpx;
  color: #7d8496;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.45;
}

.manage-card__count {
  display: block;
  margin-top: 16rpx;
  color: #6048ff;
  font-size: 26rpx;
  font-weight: 900;
}

.manage-card__empty {
  display: block;
  margin-top: 18rpx;
  color: #9aa1b2;
  font-size: 25rpx;
  font-weight: 700;
}

.member-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #eef0f6;
  border-radius: 14rpx;
  background: #fbfcff;
  box-sizing: border-box;
}

.member-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.member-card__name {
  min-width: 0;
  color: #252938;
  font-size: 28rpx;
  font-weight: 900;
}

.member-card__status {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #edf4ff;
  color: #527bff;
  font-size: 22rpx;
  font-weight: 800;
}

.member-card__status--waitlist {
  background: #fff4e6;
  color: #ff982b;
}

.member-card__line,
.member-card__sub {
  display: block;
  margin-top: 12rpx;
  color: #303445;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
  word-break: break-all;
}

.member-card__sub {
  margin-top: 8rpx;
  color: #7d8496;
  font-size: 24rpx;
  font-weight: 600;
}

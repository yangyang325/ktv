:host {
  display: block;
}

.party-card {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 14rpx;
  border: 1rpx solid #edf0f8;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: none;
  box-sizing: border-box;
}

.party-card__cover {
  position: relative;
  width: 276rpx;
  height: 196rpx;
  flex: 0 0 276rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background:
    linear-gradient(135deg, rgba(116, 69, 255, 0.25), rgba(33, 211, 255, 0.12)),
    radial-gradient(circle at 20% 20%, #e743ff 0, transparent 26%),
    radial-gradient(circle at 80% 70%, #1ec7ff 0, transparent 30%),
    linear-gradient(145deg, #17122c 0%, #070918 100%);
}

.party-card__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.party-card__cover::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(13, 10, 28, 0.02), rgba(9, 7, 18, 0.18));
  content: "";
}

.party-card__status {
  position: absolute;
  z-index: 2;
  top: 10rpx;
  left: 10rpx;
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  background: #1fd17c;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.party-card__status--signup,
.party-card__status--full {
  background: #ff9d2e;
}

.party-card__status--finished {
  background: rgba(24, 27, 47, 0.68);
}

.party-card__body {
  min-width: 0;
  flex: 1;
}

.party-card__title {
  display: block;
  overflow: hidden;
  color: #25283a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.party-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.party-card__tag {
  padding: 4rpx 11rpx;
  border-radius: 8rpx;
  background: #f1efff;
  color: #7465ff;
  font-size: 21rpx;
  font-weight: 700;
}

.party-card__meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 7rpx;
  color: #8e96aa;
  font-size: 22rpx;
  line-height: 1.3;
}

.party-card__meta-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.58;
}

.party-card__footer {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.party-card__avatars {
  display: flex;
}

.party-card__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  margin-right: -7rpx;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd4b7, #aa72ff);
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 700;
}

.party-card__avatar--blue {
  background: linear-gradient(135deg, #65c8ff, #5173ff);
}

.party-card__avatar--pink {
  background: linear-gradient(135deg, #ff89b3, #ff566f);
}

.party-card__count {
  display: flex;
  align-items: baseline;
  font-size: 24rpx;
}

.party-card__count-current {
  color: #ff5a6e;
}

.party-card__count-rest {
  color: #8e96aa;
}

.party-card__price {
  margin-left: auto;
  color: var(--danger);
  font-size: 28rpx;
  font-weight: 800;
}

.card {
  padding: 28rpx;
  border-radius: var(--radius-large);
  background: linear-gradient(180deg, #fffaf2 0%, #fff4df 100%);
  box-shadow: var(--shadow-soft);
}

.card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.card__title {
  font-size: 32rpx;
  font-weight: 600;
}

.card__status,
.card__meta,
.card__price {
  display: block;
  margin-top: 12rpx;
  color: var(--text-secondary);
}

.card__price {
  color: var(--brand-dark);
  font-weight: 600;
}

<view class="party-card" bindtap="handleTap">
  <view class="party-card__cover">
    <image
      wx:if="{{party.coverImage}}"
      class="party-card__image"
      src="{{party.coverImage}}"
      mode="aspectFill"
    />
    <text class="party-card__status party-card__status--{{statusTone}}">{{party.statusText}}</text>
  </view>
  <view class="party-card__body">
    <text class="party-card__title">{{party.title}}</text>
    <view class="party-card__tags">
      <text class="party-card__tag" wx:for="{{party.tags}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="party-card__meta">
      <image class="party-card__meta-icon" src="/assets/images/ktv/clock.svg" mode="aspectFit" />
      <text>{{party.timeSummary || '今天 20:00-23:00'}}</text>
    </view>
    <view class="party-card__meta party-card__meta--venue">
      <image class="party-card__meta-icon" src="/assets/images/ktv/location.svg" mode="aspectFit" />
      <text class="party-card__venue">{{party.venueSummary}}</text>
    </view>
    <view class="party-card__footer">
      <view class="party-card__avatars">
        <image
          wx:for="{{party.participantAvatars}}"
          wx:key="userId"
          class="party-card__avatar"
          src="{{item.avatarUrl}}"
          mode="aspectFill"
        />
      </view>
      <view class="party-card__count">
        <text class="party-card__count-current">{{progressCountText}}</text>
        <text class="party-card__count-rest">{{progressRestText}}</text>
      </view>
      <text class="party-card__price">AA参考 {{party.priceText}}</text>
    </view>
  </view>
</view>

<view class="page preview-page">
  <view class="preview-card">
    <text class="preview-card__title">活动信息文案预览</text>
    <text class="preview-card__content">{{previewText}}</text>
  </view>
  <button class="preview-page__primary" bindtap="handleCopy">复制文案</button>
  <button
    class="preview-page__secondary"
    loading="{{publishing}}"
    disabled="{{publishing}}"
    bindtap="handlePublish"
  >{{publishing ? '发布中...' : '确认发布'}}</button>
</view>

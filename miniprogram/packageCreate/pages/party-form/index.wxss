.form-page {
  padding: 28rpx 24rpx 120rpx;
}

.title-card,
.section-card,
.form-list {
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: var(--shadow-card);
}

.title-card {
  padding: 28rpx 24rpx;
}

.title-card__body {
  min-width: 0;
  flex: 1;
}

.title-card__input {
  height: 84rpx;
  color: var(--text-primary);
  font-size: 27rpx;
}

.title-card__hint {
  color: var(--text-muted);
  font-size: 22rpx;
}

.section-card {
  margin-top: 22rpx;
  padding: 24rpx;
}

.section-card__title {
  display: block;
  margin-bottom: 18rpx;
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 800;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-cloud__item {
  padding: 11rpx 22rpx;
  border: 2rpx solid #e3e7f4;
  border-radius: 14rpx;
  background: #ffffff;
  color: #596174;
  font-size: 24rpx;
  font-weight: 700;
}

.tag-cloud__item--active {
  border-color: #6242ff;
  background: #6242ff;
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(98, 66, 255, 0.22);
}

.tag-cloud__item--pressed {
  opacity: 0.76;
}

.form-list {
  margin-top: 22rpx;
  overflow: hidden;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 92rpx;
  padding: 0 24rpx;
}

.form-row + .form-row {
  border-top: 1rpx solid var(--border-color);
}

.form-row__label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 0 0 180rpx;
  min-width: 180rpx;
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 700;
  white-space: nowrap;
}

.form-row--fee {
  min-height: 104rpx;
}

.form-row--duration {
  min-height: 104rpx;
}

.form-row--fee .form-row__label {
  flex: 0 0 220rpx;
}

.form-row__label image {
  width: 30rpx;
  height: 30rpx;
}

.form-row__input {
  display: block;
  min-width: 0;
  flex: 1;
  color: var(--text-secondary);
  font-size: 25rpx;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.form-row__input--placeholder {
  color: var(--text-muted);
}

.form-row__value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--text-secondary);
  font-size: 25rpx;
  font-weight: 800;
}

.form-row__arrow {
  color: var(--text-muted);
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1;
}

.time-picker-group {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  flex: 1;
}

.time-picker__chip {
  min-width: 130rpx;
  padding: 9rpx 15rpx;
  border: 2rpx solid #e8ebf4;
  border-radius: 14rpx;
  background: #f8f9fe;
  box-sizing: border-box;
  color: var(--text-primary);
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.form-row__number {
  min-width: 110rpx;
  flex: 1;
  color: var(--text-primary);
  font-size: 27rpx;
  text-align: right;
}

.form-row__muted {
  color: var(--text-muted);
  font-size: 24rpx;
}

.preference-picker {
  display: flex;
  justify-content: flex-end;
  flex: 1;
}

.preference-picker__value {
  justify-content: flex-end;
}

.capacity-stepper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  flex: 1;
}

.capacity-stepper__button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  min-width: 42rpx;
  max-width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  border: 2rpx solid #ded8ff;
  border-radius: 50%;
  background: #f8f6ff;
  box-sizing: border-box;
  color: #6242ff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.capacity-stepper__button--pressed {
  opacity: 0.72;
  transform: scale(0.96);
}

.capacity-stepper__value {
  min-width: 92rpx;
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 800;
  text-align: center;
}

.room-type {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.room-type__item {
  padding: 9rpx 18rpx;
  border: 2rpx solid #e3e7f4;
  border-radius: 999rpx;
  background: #f5f6fb;
  box-sizing: border-box;
  color: var(--text-secondary);
  font-size: 23rpx;
  font-weight: 700;
}

.room-type__item--active {
  border-color: #6242ff;
  background: #6242ff;
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(98, 66, 255, 0.22);
}

.intro-textarea {
  width: 100%;
  min-height: 138rpx;
  color: var(--text-primary);
  font-size: 25rpx;
  line-height: 1.6;
}

.submit-button {
  position: fixed;
  display: flex;
  align-items: center;
  justify-content: center;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #8e66ff, #5237f2);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: 0 18rpx 34rpx rgba(107, 76, 255, 0.24);
}

.submit-button[disabled] {
  background: linear-gradient(135deg, #8e66ff, #5237f2);
  color: #ffffff !important;
  opacity: 1;
}

.submit-button::after {
  border: 0;
}

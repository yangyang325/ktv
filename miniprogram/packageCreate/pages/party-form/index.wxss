.form-page {
  padding: 28rpx 24rpx 120rpx;
}

.form-header {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.form-header__title {
  color: var(--text-primary);
  font-size: 36rpx;
  font-weight: 900;
}

.title-card,
.section-card,
.form-list {
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: var(--shadow-card);
}

.title-card {
  display: flex;
  gap: 22rpx;
  padding: 24rpx;
}

.upload-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  flex: 0 0 150rpx;
  flex-direction: column;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #f1efff 0%, #f7f8ff 100%);
  color: var(--text-secondary);
}

.upload-box__plus {
  color: var(--text-primary);
  font-size: 46rpx;
  font-weight: 500;
}

.upload-box__text {
  margin-top: 6rpx;
  font-size: 23rpx;
}

.title-card__body {
  min-width: 0;
  flex: 1;
}

.title-card__input {
  height: 84rpx;
  color: var(--text-primary);
  font-size: 27rpx;
}

.title-card__hint {
  color: var(--text-muted);
  font-size: 22rpx;
}

.section-card {
  margin-top: 22rpx;
  padding: 24rpx;
}

.section-card__title {
  display: block;
  margin-bottom: 18rpx;
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 800;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-cloud__item {
  padding: 11rpx 22rpx;
  border-radius: 14rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 700;
}

.form-list {
  margin-top: 22rpx;
  overflow: hidden;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 92rpx;
  padding: 0 24rpx;
}

.form-row + .form-row {
  border-top: 1rpx solid var(--border-color);
}

.form-row__label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 180rpx;
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 700;
}

.form-row__label image {
  width: 30rpx;
  height: 30rpx;
}

.form-row__input {
  min-width: 0;
  flex: 1;
  color: var(--text-secondary);
  font-size: 25rpx;
  text-align: right;
}

.form-row__number {
  min-width: 110rpx;
  flex: 1;
  color: var(--text-primary);
  font-size: 27rpx;
  text-align: right;
}

.form-row__muted {
  color: var(--text-muted);
  font-size: 24rpx;
}

.room-type {
  display: flex;
  gap: 12rpx;
  margin-left: auto;
}

.room-type__item {
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: #f5f6fb;
  color: var(--text-secondary);
  font-size: 23rpx;
  font-weight: 700;
}

.room-type__item--active {
  background: var(--brand-soft);
  color: var(--brand);
}

.intro-textarea {
  width: 100%;
  min-height: 138rpx;
  color: var(--text-primary);
  font-size: 25rpx;
  line-height: 1.6;
}

.submit-button {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  height: 78rpx;
  margin: 0;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #8e66ff, #5237f2);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 78rpx;
  box-shadow: 0 18rpx 34rpx rgba(107, 76, 255, 0.24);
}

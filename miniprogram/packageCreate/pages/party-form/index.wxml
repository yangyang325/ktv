<view class="page form-page">
  <view class="title-card">
    <view class="title-card__body">
      <input
        class="title-card__input"
        placeholder="给活动起个清晰标题吧。例：周五下班后K歌放松局"
        value="{{form.title}}"
        data-field="title"
        bindinput="handleFieldChange"
      />
      <text class="title-card__hint">请输入1字</text>
    </view>
  </view>

  <view class="section-card">
    <text class="section-card__title">选择活动属性（可多选）</text>
    <view class="tag-cloud">
      <text
        wx:for="{{tags}}"
        wx:key="name"
        class="tag-cloud__item {{item.selected ? 'tag-cloud__item--active' : ''}}"
        data-tag="{{item.name}}"
        hover-class="tag-cloud__item--pressed"
        bindtap="handleTagTap"
      >{{item.name}}</text>
    </view>
  </view>

  <view class="form-list">
    <view class="form-row">
      <view class="form-row__label">
        <image src="/assets/images/ktv/clock.svg" mode="aspectFit" />
        <text>活动时间</text>
      </view>
      <view class="time-picker-group">
        <picker mode="date" value="{{form.date}}" start="{{todayDate}}" bindchange="handleDateChange">
          <view class="time-picker__chip">{{form.date}}</view>
        </picker>
        <picker mode="time" value="{{form.startTime}}" bindchange="handleStartTimeChange">
          <view class="time-picker__chip">{{form.startTime}}</view>
        </picker>
      </view>
    </view>
    <view class="form-row" bindtap="handleVenueLocationTap">
      <view class="form-row__label">
        <image src="/assets/images/ktv/location.svg" mode="aspectFit" />
        <text>活动地点</text>
      </view>
      <text class="form-row__input {{venueId ? '' : 'form-row__input--placeholder'}}">{{venueSummary}}</text>
      <text class="form-row__arrow">›</text>
    </view>
    <view class="form-row">
      <text class="form-row__label">◈ 费用说明</text>
      <view class="room-type">
        <text class="room-type__item room-type__item--active">AA参考</text>
        <text class="room-type__item">线下自理</text>
      </view>
    </view>
    <view class="form-row">
      <view class="form-row__label">
        <image src="/assets/images/ktv/users.svg" mode="aspectFit" />
        <text>预计人数</text>
      </view>
      <view class="capacity-stepper">
        <view class="capacity-stepper__button" data-step="{{-1}}" hover-class="capacity-stepper__button--pressed" bindtap="handleCapacityStep">-</view>
        <text class="capacity-stepper__value">{{form.maxCapacity}} 人</text>
        <view class="capacity-stepper__button" data-step="{{1}}" hover-class="capacity-stepper__button--pressed" bindtap="handleCapacityStep">+</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-row__label">⚙ 曲风偏好</text>
      <picker
        class="preference-picker"
        mode="selector"
        range="{{preferenceOptions}}"
        value="{{preferenceIndex}}"
        bindchange="handlePreferenceChange"
      >
        <view class="form-row__value preference-picker__value">
          <text>{{form.preference}}</text>
          <text class="form-row__arrow">›</text>
        </view>
      </picker>
    </view>
    <view class="form-row form-row--fee">
      <view class="form-row__label">
        <image src="/assets/images/ktv/yen.svg" mode="aspectFit" />
        <text>包厢费用参考</text>
      </view>
      <input type="digit" class="form-row__number" value="{{form.roomFee}}" data-field="roomFee" bindinput="handleFieldChange" />
      <text class="form-row__muted">元</text>
    </view>
    <view class="form-row form-row--duration">
      <text class="form-row__label">⌁ 欢唱时长</text>
      <input
        type="digit"
        class="form-row__number"
        value="{{form.durationHour}}"
        data-field="durationHour"
        bindinput="handleFieldChange"
        placeholder="填写小时数"
      />
      <text class="form-row__muted">小时</text>
    </view>
  </view>

  <view class="section-card">
    <text class="section-card__title">活动介绍（选填）</text>
    <textarea
      class="intro-textarea"
      value="{{form.notes}}"
      data-field="notes"
      bindinput="handleFieldChange"
      maxlength="200"
      placeholder="说明本次活动的曲风、时间安排和线下AA参考等..."
    ></textarea>
  </view>

  <button
    class="submit-button"
    loading="{{publishing}}"
    disabled="{{publishing}}"
    bindtap="handlePublish"
  >{{publishing ? '发布中...' : '发布活动'}}</button>
</view>
